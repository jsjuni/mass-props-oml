vocabulary <http://studioj.us/metrology#> as metrology {
    extends <http://www.w3.org/2001/XMLSchema#> as xsd
    extends <http://imce.jpl.nasa.gov/foundation/base#> as base 
    extends <http://imce.jpl.nasa.gov/foundation/mission#> as mission 
    extends <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis
    extends <http://bipm.org/jcgm/vim4#> as vim4
    uses <http://iso.org/iso-80000-3.1#> as iso-80000-3.1 
    uses <http://iso.org/iso-80000-4.1#> as iso-80000-4.1 
    uses <http://iso.org/iso-80000-4.7#> as iso-80000-4.7

    ref concept vim4:IndividualUnitaryQuantity [
        key hasQuantityIdentifier
    ] < vim4:IndividualUnitaryQuantity 

    scalar property hasQuantityIdentifier [
        domain vim4:IndividualUnitaryQuantity
        range xsd:string
        functional
    ] < base:hasIdentifier, vim4:id

    concept MassQuantity < vim4:IndividualUnitaryQuantity [
        restricts vim4:instantiates to iso-80000-4.1:mass
    ]

    concept LengthQuantity < vim4:IndividualUnitaryQuantity [
        restricts vim4:instantiates to iso-80000-3.1:length
    ]

    concept CenterOfMassQuantity < LengthQuantity

    concept MomentOfInertiaQuantity < vim4:IndividualUnitaryQuantity [
        restricts vim4:instantiates to iso-80000-4.7:moment-of-inertia
    ]

    concept ProductOfInertiaQuantity < vim4:IndividualUnitaryQuantity [
        restricts vim4:instantiates to iso-80000-4.7:moment-of-inertia
    ]

    concept QuantityValue < vim4:UnitaryQuantityValue, analysis:Characterization [
        restricts all analysis:characterizes to vim4:IndividualUnitaryQuantity
        restricts all vim4:isAttributedTo to vim4:IndividualUnitaryQuantity
    ]

    concept MassValue < QuantityValue [
        restricts all analysis:characterizes to MassQuantity
        restricts all vim4:isAttributedTo to MassQuantity
        restricts all hasUnit to MassUnit
        restricts vim4:unit to iso-80000-4.1:kilogram
    ]

    concept LengthValue < QuantityValue [
        restricts all analysis:characterizes to LengthQuantity
        restricts all vim4:isAttributedTo to LengthQuantity
        restricts all hasUnit to LengthUnit
        restricts vim4:unit to iso-80000-3.1:metre
    ]

    concept CenterOfMassValue < LengthValue

    concept MomentOfInertiaValue < QuantityValue [
        restricts all analysis:characterizes to MomentOfInertiaQuantity
        restricts all vim4:isAttributedTo to MomentOfInertiaQuantity
        restricts all hasUnit to InertiaUnit
        restricts vim4:unit to iso-80000-4.7:kilogram-metre-squared
    ]

    concept ProductOfInertiaValue < QuantityValue [
        restricts all analysis:characterizes to ProductOfInertiaQuantity
        restricts all vim4:isAttributedTo to MomentOfInertiaQuantity
        restricts all hasUnit to InertiaUnit
        restricts vim4:unit to iso-80000-4.7:kilogram-metre-squared
    ]

    concept Unit

    concept MassUnit < Unit

    concept LengthUnit < Unit

    concept InertiaUnit < Unit

    scalar property hasNumber [
        domain QuantityValue
        range xsd:double
        functional
    ]

    relation entity HasUnit [
        from QuantityValue
        to Unit
        forward hasUnit
        functional
    ]

    scalar poiConvention [
        oneOf "+", "-"
    ]

    scalar property hasPoiConvention [
        domain mission:Component
        range poiConvention
        functional
    ]

    scalar property isPointMass [
        domain mission:Component
        range xsd:boolean
        functional
    ]
    
}