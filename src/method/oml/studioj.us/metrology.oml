vocabulary <http://studioj.us/metrology#> as metrology {
    extends <http://www.w3.org/2001/XMLSchema#> as xsd
    extends <http://imce.jpl.nasa.gov/foundation/base#> as base 
    extends <http://imce.jpl.nasa.gov/foundation/mission#> as mission 
    extends <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis 

    concept Quantity [
        key hasQuantityIdentifier
    ] < analysis:Characterization

    scalar property hasQuantityIdentifier [
        domain Quantity
        range xsd:string
        functional
    ] < base:hasIdentifier

    concept MassQuantity < Quantity

    concept LengthQuantity < Quantity
    concept CenterOfMassQuantity < LengthQuantity

    concept MomentOfInertiaQuantity < Quantity
    concept ProductOfInertiaQuantity < Quantity

    concept QuantityValue < analysis:Characterization [
        restricts all analysis:characterizes to Quantity
    ]

    concept MassValue < QuantityValue [
        restricts all analysis:characterizes to MassQuantity
        restricts all hasUnit to MassUnit
    ]

    concept LengthValue < QuantityValue [
        restricts all analysis:characterizes to LengthQuantity
        restricts all hasUnit to LengthUnit
    ]
    concept CenterOfMassValue < LengthValue

    concept MomentOfInertiaValue < QuantityValue [
        restricts all analysis:characterizes to MomentOfInertiaQuantity
        restricts all hasUnit to InertiaUnit
    ]

    concept ProductOfInertiaValue < QuantityValue [
        restricts all analysis:characterizes to ProductOfInertiaQuantity
        restricts all hasUnit to InertiaUnit
    ]

    concept Unit

    concept MassUnit < Unit

    concept LengthUnit < Unit

    concept InertiaUnit < Unit

    scalar property hasNumber [
        domain QuantityValue
        range xsd:double
        functional
    ]

    relation entity HasUnit [
        from QuantityValue
        to Unit
        forward hasUnit
        functional
    ]

    scalar poiConvention [
        oneOf "+", "-"
    ]

    scalar property hasPoiConvention [
        domain mission:Component
        range poiConvention
        functional
    ]

    scalar property isPointMass [
        domain mission:Component
        range xsd:boolean
        functional
    ]
}