vocabulary <http://studioj.us/base#> as base {
    extends <http://imce.jpl.nasa.gov/foundation/base#> as imce-base 
    extends <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    extends <http://imce.jpl.nasa.gov/foundation/project#> as project

    ref concept mission:Component [
        key hasComponentIdentifier
    ]
    
    ref concept project:WorkPackage [
        key hasWorkPackageIdentifier
    ]

    ref concept project:Project [
        key hasProjectIdentifier
    ]
    
    ref concept mission:Interface [
        key hasInterfaceIdentifier
    ]

    scalar property hasComponentIdentifier [
        domain mission:Component
        functional
    ] < imce-base:hasIdentifier

    scalar property hasWorkPackageIdentifier [
        domain project:WorkPackage
        functional
    ] < imce-base:hasIdentifier

    scalar property hasProjectIdentifier [
        domain project:Project
        functional
    ] < imce-base:hasIdentifier

    scalar property hasInterfaceIdentifier [
        domain mission:Interface
        functional
    ] < imce-base:hasIdentifier

}