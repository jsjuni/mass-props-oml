@dc:creator "J Steven Jenkins https://orcid.org/0000-0002-0725-0884"
@dc:description "OML formalization of VIM4 Committee Draft 2 31 July 2023"
@dc:source "https://www.bipm.org/documents/20126/115700832/VIM4_2CD_clean/c6d0dfb2-ddbf-059e-1f74-9b025c9c59d8"
description <http://bipm.org/jcgm/vim3-d#> as vim3-d {

	uses <http://purl.org/dc/elements/1.1/> as dc

	uses <http://www.w3.org/2000/01/rdf-schema#> as rdfs

	uses <http://bipm.org/jcgm/vim3-v#> as vim3-v

	//
	//
	// 1 Quantities and units
	//
	//

	//
	// 1.6 International System of Quantities
	//

	@rdfs:label "International System Of Quantities"
	@rdfs:label "ISQ"
	@rdfs:isDefinedBy "VIM3 §1.6"
	instance ISQ : vim3-v:SystemOfQuantities

	//
	// 1.16 International System of Units
	//

	@rdfs:label "International System Of Units"
	@rdfs:label "SI"
	@rdfs:isDefinedBy "VIM3 §1.16"
	instance SI : vim3-v:SystemOfUnits

}