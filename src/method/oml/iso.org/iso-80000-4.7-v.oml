@dc:description "The ISO-80000-4 library."
@dc:title "ISO-80000-4.1 mass, kilgram"
vocabulary <http://iso.org/iso-80000-4.7-v#> as iso-80000-4.7-vocab {

    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://bipm.org/jcgm/vim3#> as vim3

    uses <http://iso.org/iso-80000-4.7-d#> as iso-80000-4.7-d

    concept MomentOfInertiaQuantity = vim3:Quantity [
        restricts vim3:isSameKindAs to iso-80000-4.7-d:moment_of_inertia
    ]

}