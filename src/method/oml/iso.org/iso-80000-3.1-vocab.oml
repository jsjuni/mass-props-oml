@dc:description "The ISO-80000-3 library."
@dc:title "ISO-80000-3.1 length, metre"
vocabulary <http://iso.org/iso-80000-3.1-vocab#> as iso-80000-3.1-vocab {

    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://bipm.org/jcgm/vim3#> as vim3

    uses <http://iso.org/iso-80000-3.1#> as iso-80000-3.1

    concept LengthQuantity = vim3:Quantity [
        restricts vim3:isSameKindAs to iso-80000-3.1:length
    ]

}