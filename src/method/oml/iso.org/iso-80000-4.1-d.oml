@dc:description "The ISO-80000-4 library."
@dc:title "ISO-80000-4.1 mass, kilogram"
description <http://iso.org/iso-80000-4.1-d#> as iso-80000-4.1 {

    uses <http://www.w3.org/2002/07/owl#> as owl
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://bipm.org/jcgm/vim3#> as vim3

    extends <http://iso.org/iso-80000-1-d#> as iso-80000-1-d

    instance M : vim3:BaseDimension [
        vim3:hasDimensionSymbol "M"
    ]

    instance mass : vim3:Quantity [
        vim3:hasQuantityIdentifier "mass"
        vim3:isSameKindAs mass
        vim3:hasQuantityDimension : vim3:QuantityDimension [
            vim3:hasDimensionFactor : vim3:BaseDimensionPower [ 
                vim3:raisesBaseDimension M
                vim3:toPower "1/1"^^owl:rational
            ]
        ]
        vim3:hasDimensionSymbol "M"
    ]

    relation instance mass_base_quanity_isq : vim3:IsBaseQuantityIn [
        from mass
        to iso-80000-1-d:ISQ
        vim3:withBaseDimension M
    ]

    instance kilogram : vim3:MeasurementUnit [
        vim3:hasMeasurementUnitIdentifier "kilogram"
        vim3:isBaseUnitIn mass_base_quanity_isq
    ]
}