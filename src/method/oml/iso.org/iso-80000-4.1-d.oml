@dc:description "The ISO-80000-4 library."
@dc:title "ISO-80000-4.1 mass, kilogram"
description <http://iso.org/iso-80000-4.1-d#> as iso-80000-4.1 {

    uses <http://www.w3.org/2002/07/owl#> as owl
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://bipm.org/jcgm/vim3-v#> as vim3-v

    extends <http://iso.org/iso-80000-1-d#> as iso-80000-1-d

    instance M : vim3-v:BaseDimension [
        vim3-v:hasDimensionSymbol "M"
    ]

    instance mass : vim3-v:Quantity [
        vim3-v:hasQuantityIdentifier "mass"
        vim3-v:isSameKindAs mass
        vim3-v:hasQuantityDimension : vim3-v:QuantityDimension [
            vim3-v:hasDimensionFactor : vim3-v:BaseDimensionPower [ 
                vim3-v:raisesBaseDimension M
                vim3-v:toPower "1/1"^^owl:rational
            ]
        ]
        vim3-v:hasDimensionSymbol "M"
    ]

    relation instance mass_base_quanity_isq : vim3-v:IsBaseQuantityIn [
        from mass
        to iso-80000-1-d:ISQ
        vim3-v:withBaseDimension M
    ]

    instance kilogram : vim3-v:MeasurementUnit [
        vim3-v:hasMeasurementUnitIdentifier "kilogram"
        vim3-v:isBaseUnitIn mass_base_quanity_isq
    ]
}