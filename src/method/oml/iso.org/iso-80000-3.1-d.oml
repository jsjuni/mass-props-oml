@dc:description "The ISO-80000-3 library."
@dc:title "ISO-80000-3.1 length, metre"
description <http://iso.org/iso-80000-3.1-d#> as iso-80000-3.1-d {

    uses <http://www.w3.org/2002/07/owl#> as owl
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://bipm.org/jcgm/vim3#> as vim3

    extends <http://iso.org/iso-80000-1-d#> as iso-80000-1-d

    instance L : vim3:BaseDimension [
        vim3:hasDimensionSymbol "L"
    ]

    instance ^length : vim3:Quantity [
        vim3:hasQuantityIdentifier "length"
        vim3:isSameKindAs ^length
        vim3:hasQuantityDimension : vim3:QuantityDimension [
            vim3:hasDimensionFactor : vim3:BaseDimensionPower [ 
                vim3:raisesBaseDimension L
                vim3:toPower "1/1"^^owl:rational
            ]
        ]
        vim3:hasDimensionSymbol "L"
    ]

    relation instance length_base_quanity_isq : vim3:IsBaseQuantityIn [
        from ^length
        to iso-80000-1-d:ISQ
        vim3:withBaseDimension L
    ]

    instance metre : vim3:MeasurementUnit [
        vim3:hasMeasurementUnitIdentifier "metre"
        vim3:isBaseUnitIn length_base_quanity_isq
    ]
}