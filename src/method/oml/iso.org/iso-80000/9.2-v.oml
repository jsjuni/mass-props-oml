@dc:description "The ISO-80000-9 library."
@dc:title "ISO-80000-9.2 amount of substance, mole"
vocabulary <http://iso.org/iso-80000/9.2-v#> as iso-80000-9.2-v {

    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://bipm.org/jcgm/vim3-v#> as vim3-v
	extends <http://iso.org/iso-80000/1-v#> as iso-80000-1-v

	uses <http://iso.org/iso-80000/9.2-d#> as iso-80000-9.2-d

    concept AmountOfSubstance < iso-80000-1-v:Quantity [
        restricts vim3-v:isSameKindAs to iso-80000-9.2-d:amount_of_substance
        restricts all vim3-v:hasMagnitude to AmountOfSubstanceValue
    ]

    concept AmountOfSubstanceUnit < iso-80000-1-v:Unit [
        restricts vim3-v:isSameKindAs to iso-80000-9.2-d:amount_of_substance
    ]

    concept AmountOfSubstanceValue < iso-80000-1-v:Value [
        restricts all vim3-v:expressesMagnitudeOf to AmountOfSubstance
        restricts all vim3-v:hasReference to AmountOfSubstanceUnit
    ]
    
}