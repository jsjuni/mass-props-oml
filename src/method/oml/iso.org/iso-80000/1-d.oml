@dc:title "ISO-80000-1"
description <http://iso.org/iso-80000/1-d#> as iso-80000-1-d {

	uses <http://purl.org/dc/elements/1.1/> as dc
	uses <http://www.w3.org/2000/01/rdf-schema#> as rdfs
	uses <http://bipm.org/jcgm/vim3-v#> as vim3-v
	uses <http://iso.org/iso-80000/1-v#> as iso-80000-1-v

	uses <http://www.w3.org/2001/XMLSchema#> as xsd

	@rdfs:comment "The International System of Quantities"
    instance ISQ : vim3-v:SystemOfQuantities [
    	vim3-v:hasSystemOfQuantitiesIdentifier "ISQ"
	]
  
	instance one : iso-80000-1-v:Unit, iso-80000-1-v:CoherentDerivedUnit [
		iso-80000-1-v:hasUnitIdentifier "one"
	]

    @rdfs:comment "The International System of Units"
    @rdfs:seeAlso "https://www.bipm.org/en/publications/si-brochure/"
    instance SI : vim3-v:CoherentSystemOfUnits [
		vim3-v:hasSystemOfUnitsIdentifier "SI"
		vim3-v:isSystemOfUnitsFor ISQ
	]
	
	//
	//
	// placeholder
	//
	//

	instance empty_tensor_component_description_list : iso-80000-1-v:EmptyTensorComponentDescriptionList

	//
	// scalar shapes
	//

	instance scalar_component_description_list : iso-80000-1-v:TensorComponentDescriptionList [
		iso-80000-1-v:hasNext empty_tensor_component_description_list
	]

	instance real_scalar_tensor_shape : iso-80000-1-v:RealTensorShape, iso-80000-1-v:ScalarTensorShape

	instance complex_scalar_tensor_shape : iso-80000-1-v:ComplexTensorShape, iso-80000-1-v:ScalarTensorShape

	//
	// vector shapes
	//

	// double

	instance vector_2_component_description_list : iso-80000-1-v:VectorComponentDescriptionList [
		iso-80000-1-v:hasNext empty_tensor_component_description_list
		iso-80000-1-v:hasComponentCardinality 2
	]

	instance real_vector_2_tensor_shape : iso-80000-1-v:RealTensorShape, iso-80000-1-v:HomogeneousTensorShape, iso-80000-1-v:VectorTensorShape [
		iso-80000-1-v:hasTensorComponentDescriptionList vector_2_component_description_list
	]

	instance complex_vector_2_tensor_shape : iso-80000-1-v:ComplexTensorShape, iso-80000-1-v:HomogeneousTensorShape, iso-80000-1-v:VectorTensorShape [
		iso-80000-1-v:hasTensorComponentDescriptionList vector_2_component_description_list
	]

	// triple

	instance vector_3_component_description_list : iso-80000-1-v:VectorComponentDescriptionList [
		iso-80000-1-v:hasNext empty_tensor_component_description_list
		iso-80000-1-v:hasComponentCardinality 3
	]

	instance real_vector_3_tensor_shape : iso-80000-1-v:RealTensorShape, iso-80000-1-v:HomogeneousTensorShape, iso-80000-1-v:VectorTensorShape [
		iso-80000-1-v:hasTensorComponentDescriptionList vector_3_component_description_list
	]

	instance complex_vector_3_tensor_shape : iso-80000-1-v:ComplexTensorShape, iso-80000-1-v:HomogeneousTensorShape, iso-80000-1-v:VectorTensorShape [
		iso-80000-1-v:hasTensorComponentDescriptionList vector_3_component_description_list
	]

	//
	// matrix shapes
	//

	// 2 x 2

	instance matrix_2x2_component_description_list : iso-80000-1-v:MatrixComponentDescriptionList [
		iso-80000-1-v:hasNext vector_2_component_description_list
		iso-80000-1-v:hasComponentCardinality 2
	]

	instance real_matrix_2x2_tensor_shape : iso-80000-1-v:RealTensorShape, iso-80000-1-v:HomogeneousTensorShape, iso-80000-1-v:MatrixTensorShape [
		iso-80000-1-v:hasTensorComponentDescriptionList matrix_2x2_component_description_list
	]

	instance complex_matrix_2x2_tensor_shape : iso-80000-1-v:ComplexTensorShape, iso-80000-1-v:HomogeneousTensorShape, iso-80000-1-v:MatrixTensorShape [
		iso-80000-1-v:hasTensorComponentDescriptionList matrix_2x2_component_description_list
	]

	// 3 x 3

	instance matrix_3x3_component_description_list : iso-80000-1-v:MatrixComponentDescriptionList [
		iso-80000-1-v:hasNext vector_3_component_description_list
		iso-80000-1-v:hasComponentCardinality 3
	]

	instance real_matrix_3x3_tensor_shape : iso-80000-1-v:RealTensorShape, iso-80000-1-v:HomogeneousTensorShape, iso-80000-1-v:MatrixTensorShape [
		iso-80000-1-v:hasTensorComponentDescriptionList matrix_3x3_component_description_list
	]

	instance complex_matrix_3x3_tensor_shape : iso-80000-1-v:ComplexTensorShape, iso-80000-1-v:HomogeneousTensorShape, iso-80000-1-v:MatrixTensorShape [
		iso-80000-1-v:hasTensorComponentDescriptionList matrix_3x3_component_description_list
	]
	
    //
    //
    // multiples and submultiples
    //
    //

 
    instance yotta : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "Y"
        vim3-v:hasPrefixName "yotta"
        vim3-v:hasFactor "1e24"^^xsd:double
    ]
    instance zetta : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "Z"
        vim3-v:hasPrefixName "zetta"
        vim3-v:hasFactor "1e21"^^xsd:double
    ]
    instance exa : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "E"
        vim3-v:hasPrefixName "exa"
        vim3-v:hasFactor "1e18"^^xsd:double
    ]
    instance peta : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "P"
        vim3-v:hasPrefixName "peta"
        vim3-v:hasFactor "1e15"^^xsd:double
    ]
    instance tera : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "T"
        vim3-v:hasPrefixName "tera"
        vim3-v:hasFactor "1e12"^^xsd:double
    ]
    instance giga : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "G"
        vim3-v:hasPrefixName "giga"
        vim3-v:hasFactor "1e9"^^xsd:double
    ]
    instance mega : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "M"
        vim3-v:hasPrefixName "mega"
        vim3-v:hasFactor "1e6"^^xsd:double
    ]
    instance kilo : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "k"
        vim3-v:hasPrefixName "kilo"
        vim3-v:hasFactor "1e3"^^xsd:double
    ]
    instance hecto : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "h"
        vim3-v:hasPrefixName "hecto"
        vim3-v:hasFactor "1e2"^^xsd:double
    ]
    instance deca : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "da"
        vim3-v:hasPrefixName "deca"
        vim3-v:hasFactor "1e1"^^xsd:double
    ]
    instance deci : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "d"
        vim3-v:hasPrefixName "deci"
        vim3-v:hasFactor "1e-1"^^xsd:double
    ]
    instance centi : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "c"
        vim3-v:hasPrefixName "centi"
        vim3-v:hasFactor "1e-2"^^xsd:double
    ]
    instance milli : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "m"
        vim3-v:hasPrefixName "milli"
        vim3-v:hasFactor "1e-3"^^xsd:double
    ]
    instance micro : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "µ"
        vim3-v:hasPrefixName "micro"
        vim3-v:hasFactor "1e-6"^^xsd:double
    ]
    instance nano : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "n"
        vim3-v:hasPrefixName "nano"
        vim3-v:hasFactor "1e-9"^^xsd:double
    ]
    instance pico : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "p"
        vim3-v:hasPrefixName "pico"
        vim3-v:hasFactor "1e-12"^^xsd:double
    ]
    instance femto : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "f"
        vim3-v:hasPrefixName "femto"
        vim3-v:hasFactor "1e-15"^^xsd:double
    ]
    instance atto : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "a"
        vim3-v:hasPrefixName "atto"
        vim3-v:hasFactor "1e-18"^^xsd:double
    ]
    instance zepto : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "z"
        vim3-v:hasPrefixName "zepto"
        vim3-v:hasFactor "1e-21"^^xsd:double
    ]
    instance yocto : iso-80000-1-v:Multiple [
        vim3-v:hasPrefixSymbol "y"
        vim3-v:hasPrefixName "yocto"
        vim3-v:hasFactor "1e-24"^^xsd:double
    ]

}
