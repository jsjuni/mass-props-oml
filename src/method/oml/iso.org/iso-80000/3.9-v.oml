@dc:description "The ISO-80000-3 library."
@dc:title "ISO-80000-3.9 time, second"
vocabulary <http://iso.org/iso-80000/3.9-v#> as iso-80000-3.9-v {

    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://bipm.org/jcgm/vim3-v#> as vim3-v
	extends <http://iso.org/iso-80000/1-v#> as iso-80000-1-v

    uses <http://iso.org/iso-80000/3.9-d#> as iso-80000-3.9-d

    concept Time < iso-80000-1-v:ISQQuantity [
        restricts vim3-v:isSameKindAs to iso-80000-3.9-d:time
    ]

    concept TimeUnit < iso-80000-1-v:SIBaseUnit [
        restricts vim3-v:isSameKindAs to iso-80000-3.9-d:time
    ]

    concept TimeValue < iso-80000-1-v:SIValue [
        restricts all vim3-v:hasReference to TimeUnit
    ]
    
}