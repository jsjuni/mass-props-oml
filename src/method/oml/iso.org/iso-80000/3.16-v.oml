@dc:description "The ISO-80000-3 library."
@dc:title "ISO-80000-3.16 rotation"
vocabulary <http://iso.org/iso-80000/3.16-v#> as iso-80000-3.16-v {

    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://bipm.org/jcgm/vim3-v#> as vim3-v
 	extends <http://iso.org/iso-80000/1-v#> as iso-80000-1-v

    uses <http://iso.org/iso-80000/3.16-d#> as iso-80000-3.16-d

	uses <http://iso.org/iso-80000/1-d#> as iso-80000-1-d

    @dc:description """Rotation is the class of all quantities of kind rotation. It classifies metrology, not provenance."""
    concept Rotation < iso-80000-1-v:QuantityOfDimensionOne [
        restricts vim3-v:isSameKindAs to iso-80000-3.16-d:rotation
        restricts all vim3-v:hasMagnitude to RotationValue
    ]

    relation isRotationOf [
        from vim3-v:Object
        to Rotation
        reverse hasRotation
    ] < vim3-v:isPropertyOf
    
    concept RotationValue < iso-80000-1-v:Value [
        restricts all vim3-v:expressesMagnitudeOf to Rotation
        restricts vim3-v:hasReference to iso-80000-1-d:one
    ]
    
}