@dc:description "The ISO-80000-6 library."
@dc:title "ISO-80000-6.1 electric current, ampere"
description <http://iso.org/iso-80000/6.1-d#> as iso-80000-6.1-d {

    uses <http://www.w3.org/2002/07/owl#> as owl
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://bipm.org/jcgm/vim3-v#> as vim3-v
    uses <http://iso.org/iso-80000/1-v#> as iso-80000-1-v
    uses <http://iso.org/iso-80000/6.1-v#> as iso-80000-6.1-v

    instance I : iso-80000-1-v:ISQDimension [
        vim3-v:hasDimensionSymbol "I"
    ]

    instance electric_current : iso-80000-6.1-v:ElectricCurrent, iso-80000-1-v:ISQBaseQuantity [
        vim3-v:hasQuantityIdentifier "electric current"
        vim3-v:hasQuantityDimension : vim3-v:QuantityDimension [
            vim3-v:hasDimensionFactor : vim3-v:BaseDimensionPower [ 
                vim3-v:raisesBaseDimension I
                vim3-v:toPower "1/1"^^owl:rational
            ]
            vim3-v:hasDimensionSymbol "Θ"
        ]
        iso-80000-1-v:hasDimension I
    ]

    instance kelvin : iso-80000-6.1-v:ElectricCurrentUnit [
        vim3-v:hasMeasurementUnitIdentifier "kelvin"
        iso-80000-1-v:isBaseUnitFor electric_current
    ]
}