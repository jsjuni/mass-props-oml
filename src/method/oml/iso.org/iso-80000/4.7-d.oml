@dc:description "The ISO-80000-4 library."
@dc:title "ISO-80000-4.7 moment of inertia, kilogram meter squared"
description <http://iso.org/iso-80000/4.7-d#> as iso-80000-4.7-d {

    uses <http://www.w3.org/2002/07/owl#> as owl
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://bipm.org/jcgm/vim3-v#> as vim3-v
    uses <http://iso.org/iso-80000/1-v#> as iso-80000-1-v
    uses <http://iso.org/iso-80000/4.7-v#> as iso-80000-4.7-v
 
    extends <http://iso.org/iso-80000/3.1-d#> as iso-80000-3.1-d
    extends <http://iso.org/iso-80000/4.1-d#> as iso-80000-4.1-d
   
    instance moment_of_inertia : iso-80000-4.7-v:MomentOfInertia, iso-80000-1-v:DerivedQuantity [
        iso-80000-1-v:hasQuantityIdentifier "moment of inertia"
        vim3-v:hasQuantityDimension : vim3-v:QuantityDimension [
            vim3-v:hasDimensionFactor : vim3-v:BaseDimensionPower [ 
                vim3-v:raisesBaseDimension iso-80000-4.1-d:M
                vim3-v:toPower "1/1"^^owl:rational
            ]
            vim3-v:hasDimensionFactor : vim3-v:BaseDimensionPower [ 
                vim3-v:raisesBaseDimension iso-80000-3.1-d:L
                vim3-v:toPower "2/1"^^owl:rational
            ]
            vim3-v:hasDimensionSymbol "ML<sup>2</sup>"
        ]
    ]

    instance kilogram_metre_squared : iso-80000-4.7-v:MomentOfInertiaUnit, iso-80000-1-v:CoherentDerivedUnit [
        iso-80000-1-v:hasUnitIdentifier "kilogram metre squared"
        iso-80000-1-v:isCoherentDerivedUnitFor moment_of_inertia
    ]

}