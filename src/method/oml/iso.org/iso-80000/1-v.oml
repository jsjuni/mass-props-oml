@dc:creator "J Steven Jenkins https://orcid.org/0000-0002-0725-0884"
vocabulary <http://iso.org/iso-80000/1-v#> as iso-80000-1-v {

 	extends <http://www.w3.org/2001/XMLSchema#> as xsd
    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://bipm.org/jcgm/vim3-v#> as vim3-v

    uses <http://iso.org/iso-80000/1-d#> as iso-80000-1-d

    @dc:description """Dimension contains those and only those dimensions that are defined as base dimensions in the ISQ.
                    It classifies provenance and metrology."""
    concept Dimension [
        key vim3-v:hasDimensionSymbol
    ] < vim3-v:BaseDimension 

    @dc:description """Quantity contains those quantities whose definition is consistent with the semantics
                    of quantity as defined in VIM3 and ISQ. It classifies metrology, not provenance."""
    concept Quantity [
        key hasQuantityIdentifier
    ] < vim3-v:Quantity

    scalar property hasQuantityIdentifier [
        domain Quantity
        range xsd:string
        functional
    ] < vim3-v:hasQuantityIdentifier

    @dc:description """ISQBaseQuantity contains those and only those quantities that are defined as base quantities in the ISQ.
                    It classifies provenance, not metrology."""
    aspect ISQBaseQuantity < [
        restricts vim3-v:isBaseQuantityIn to iso-80000-1-d:ISQ
    ]

    relation hasDimension [
        from ISQBaseQuantity
        to Dimension
        functional
        inverse functional
    ]

    @dc:description """ISQDerivedQuantity contains those and only those quantities that are defined as derived quantities in the ISQ.
                    It classifies provenance, not metrology."""
    aspect ISQDerivedQuantity < [
        restricts vim3-v:isDerivedQuantityIn to iso-80000-1-d:ISQ
    ]

    @dc:description """QuantityOfDimensionOne contains those quantities whose definition is consistent with the semantics
                    of quantity of dimension one as defined in VIM3 and SI. It classifies metrology, not provenance."""
    concept QuantityOfDimensionOne < vim3-v:QuantityOfDimensionOne, Quantity

    scalar property hasUnitIdentifier [
        domain Unit
        range xsd:string
        functional
    ] < vim3-v:hasMeasurementUnitIdentifier

    @dc:description """Unit contains those units whose definition is consistent with the semantics
                    of unit as defined in VIM3 and SI. It classifies metrology, not provenance."""
    concept Unit [
        key hasUnitIdentifier
    ] < vim3-v:MeasurementUnit, vim3-v:Reference, Quantity

    @dc:description """SIBaseUnit contains those and only those units that are defined as base units in the SI.
                    It classifies provenance, not metrology."""
     aspect SIBaseUnit < [
        restricts vim3-v:isBaseUnitIn to iso-80000-1-d:SI
    ]

    relation isBaseUnitFor [
        from SIBaseUnit
        to ISQBaseQuantity
        functional
        inverse functional
    ]

    @dc:description """SIDerivedUnit contains those and only those units that are defined as derived units in the SI.
                    It classifies provenance, not metrology."""
    aspect SIDerivedUnit < [
        restricts vim3-v:isDerivedUnitIn to iso-80000-1-d:SI
    ]

    relation isDerivedUnitFor [
        from SIDerivedUnit
        to ISQDerivedQuantity
        functional
        inverse functional
    ]

    @dc:description """CoherentDerivedUnit contains those and only those units that are defined as coherent derived units in the SI.
                    It classifies provenance, not metrology."""
    aspect CoherentDerivedUnit < SIDerivedUnit [
         restricts vim3-v:isCoherentDerivedUnitIn to iso-80000-1-d:SI
    ]

    relation isCoherentDerivedUnitFor [
        from SIDerivedUnit
        to ISQDerivedQuantity
        functional
        inverse functional
    ] < isDerivedUnitFor

    concept Value < vim3-v:QuantityValue
    
    //
    //
    // temporary location for tensor shape mechanism
    //
    //

    //
    // tensor component description
    //

    aspect TensorComponentDescription

    scalar property hasComponentCardinality [
        domain TensorComponentDescription
        range xsd:positiveInteger
    ]

    //
    // tensor component description list
    //

    aspect TensorComponentDescriptionList

    relation hasTensorComponentDescription [
        from TensorComponentDescriptionList
        to TensorShape
        functional
    ]

    relation isFollowedBy [
        from TensorComponentDescriptionList
        to TensorComponentDescriptionList
       transitive
    ]

    relation hasNext [
        from TensorComponentDescriptionList
        to TensorComponentDescriptionList
        functional
        irreflexive
        asymmetric
    ] < isFollowedBy

    aspect EmptyTensorComponentDescriptionList < TensorComponentDescriptionList [
        restricts hasNext to exactly 0
    ]

    aspect VectorComponentDescriptionList < TensorComponentDescriptionList [
        // restricts isFollowedBy to exactly 2 // 1 plus list terminator
    ]

    aspect MatrixComponentDescriptionList< TensorComponentDescriptionList [
        // restricts isFollowedBy to exactly 3 // 2 plus list terminator
    ]

    //
    // tensor shape
    //

    relation isSameShapeAs [
        from Quantity
        to TensorShape
        functional
    ]

    aspect TensorShape [
        key hasTensorShapeIdentifier
    ]

    scalar property hasTensorShapeIdentifier [
        domain TensorShape
        range xsd:string
        functional
    ]

    scalar property hasTensorOrder [
        domain TensorShape
        range xsd:nonNegativeInteger
        functional
    ]

    relation hasTensorComponentDescriptionList [
        from TensorShape
        to TensorComponentDescriptionList
        functional
    ]

    scalar field_type [
        oneOf "real", "complex"
    ]

    scalar property hasFieldType [
        domain TensorShape
        range field_type
        functional
    ]

    scalar property isHomogeneous [
        domain TensorShape
        range xsd:boolean
        functional
    ]

    scalar property isCartesian [
        domain TensorShape
        range xsd:boolean
        functional
    ]

    aspect CartesianComponentDescription < TensorShape [
        restricts isCartesian to true
    ]
    
    aspect RealTensorShape < TensorShape [
        restricts hasFieldType to "real"
    ]
    
    aspect ComplexTensorShape < TensorShape [
        restricts hasFieldType to "complex"
    ]
    
    aspect ScalarTensorShape < TensorShape [
        restricts hasTensorOrder to 0
        restricts hasTensorComponentDescriptionList to max 0
    ]

    aspect HigherOrderTensorShape < TensorShape [
        restricts all hasTensorOrder to xsd:nonPositiveInteger
        restricts hasTensorComponentDescriptionList to min 1
    ]

    aspect VectorTensorShape < TensorShape [
        restricts hasTensorOrder to 1
        restricts all hasTensorComponentDescriptionList to VectorComponentDescriptionList
    ]

    aspect MatrixTensorShape < TensorShape [
        restricts hasTensorOrder to 2
        restricts all hasTensorComponentDescriptionList to MatrixComponentDescriptionList
    ]

    aspect HomogeneousTensorShape < TensorShape [
        restricts isHomogeneous to true
    ]

    aspect RealMatrix3x3Quantity < [
        restricts isSameShapeAs to iso-80000-1-d:real_matrix_3x3_tensor_shape
    ]

    //
    //
    // multiples and submultiples
    //
    //

    aspect Multiple < vim3-v:Multiple

    aspect SIMultipleOfUnit < [
        restricts vim3-v:isMultipleOfUnitIn to iso-80000-1-d:SI
    ]

    aspect SISubmultipleOfUnit < [
        restricts vim3-v:isSubmultipleOfUnitIn to iso-80000-1-d:SI
    ]

 }