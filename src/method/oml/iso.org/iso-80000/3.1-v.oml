@dc:description "The ISO-80000-3 library."
@dc:title "ISO-80000-3.1 length, metre"
vocabulary <http://iso.org/iso-80000/3.1-v#> as iso-80000-3.1-v {

    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://bipm.org/jcgm/vim3-v#> as vim3-v
	extends <http://iso.org/iso-80000/1-v#> as iso-80000-1-v

    uses <http://iso.org/iso-80000/3.1-d#> as iso-80000-3.1-d

    concept Length < iso-80000-1-v:ISQBaseQuantity [
        restricts vim3-v:isSameKindAs to iso-80000-3.1-d:length
    ]

    concept LengthUnit < iso-80000-1-v:SIBaseUnit [
        restricts vim3-v:isSameKindAs to iso-80000-3.1-d:length
    ]

    concept LengthValue < iso-80000-1-v:SIValue [
        restricts all vim3-v:hasReference to LengthUnit
    ]
    
}