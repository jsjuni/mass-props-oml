@dc:description "The ISO-80000-3 library."
@dc:title "ISO-80000-3.1 length, metre"
description <http://iso.org/iso-80000/3.1-d#> as iso-80000-3.1-d {

    uses <http://www.w3.org/2002/07/owl#> as owl
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://bipm.org/jcgm/vim3-v#> as vim3-v
    uses <http://iso.org/iso-80000/1-v#> as iso-80000-1-v
    uses <http://iso.org/iso-80000/3.1-v#> as iso-80000-3.1-v

    instance L : iso-80000-1-v:Dimension [
        vim3-v:hasDimensionSymbol "L"
    ]

    instance ^length : iso-80000-3.1-v:Length, iso-80000-1-v:BaseQuantity [
        iso-80000-1-v:hasQuantityIdentifier "length"
        vim3-v:hasQuantityDimension : vim3-v:QuantityDimension [
            vim3-v:hasDimensionFactor : vim3-v:BaseDimensionPower [ 
                vim3-v:raisesBaseDimension L
                vim3-v:toPower "1/1"^^owl:rational
            ]
            vim3-v:hasDimensionSymbol "L"
        ]
        iso-80000-1-v:hasDimension L
    ]

    instance metre : iso-80000-3.1-v:LengthUnit, iso-80000-1-v:BaseUnit [
        iso-80000-1-v:hasUnitIdentifier "metre"
        iso-80000-1-v:isBaseUnitFor ^length
    ]
}