@dc:description "The ISO-80000-9 library."
@dc:title "ISO-80000-9.2 amount of substance, mole"
description <http://iso.org/iso-80000/9.2-d#> as iso-80000-9.2-d {

    uses <http://www.w3.org/2002/07/owl#> as owl
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://bipm.org/jcgm/vim3-v#> as vim3-v
    uses <http://iso.org/iso-80000/1-v#> as iso-80000-1-v
    uses <http://iso.org/iso-80000/9.2-v#> as iso-80000-9.2-v

    instance N : iso-80000-1-v:Dimension [
        vim3-v:hasDimensionSymbol "N"
    ]

    instance amount_of_substance : iso-80000-9.2-v:AmountOfSubstance, iso-80000-1-v:BaseQuantity [
        iso-80000-1-v:hasQuantityIdentifier "amount of substance"
        vim3-v:hasQuantityDimension : vim3-v:QuantityDimension [
            vim3-v:hasDimensionFactor : vim3-v:BaseDimensionPower [ 
                vim3-v:raisesBaseDimension N
                vim3-v:toPower "1/1"^^owl:rational
            ]
            vim3-v:hasDimensionSymbol "N"
        ]
        iso-80000-1-v:hasDimension N
    ]

    instance mole : iso-80000-9.2-v:AmountOfSubstanceUnit, iso-80000-1-v:BaseUnit [
        iso-80000-1-v:hasUnitIdentifier "mole"
        iso-80000-1-v:isBaseUnitFor amount_of_substance
    ]
}