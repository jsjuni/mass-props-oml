@dc:description "The ISO-80000-4 library."
@dc:title "ISO-80000-4.1 mass, kilogram"
description <http://iso.org/iso-80000/4.1-d#> as iso-80000-4.1-d {

    uses <http://www.w3.org/2002/07/owl#> as owl
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://bipm.org/jcgm/vim3-v#> as vim3-v
    uses <http://iso.org/iso-80000/1-v#> as iso-80000-1-v
    uses <http://iso.org/iso-80000/4.1-v#> as iso-80000-4.1-v

    instance M : iso-80000-1-v:ISQDimension [
        vim3-v:hasDimensionSymbol "M"
    ]

    instance mass : iso-80000-4.1-v:Mass, iso-80000-1-v:ISQBaseQuantity [
        vim3-v:hasQuantityIdentifier "mass"
        vim3-v:hasQuantityDimension : vim3-v:QuantityDimension [
            vim3-v:hasDimensionFactor : vim3-v:BaseDimensionPower [ 
                vim3-v:raisesBaseDimension M
                vim3-v:toPower "1/1"^^owl:rational
            ]
            vim3-v:hasDimensionSymbol "M"
        ]
        iso-80000-1-v:hasDimension M
    ]

    instance kilogram : iso-80000-4.1-v:MassUnit, iso-80000-1-v:SIBaseUnit [
        vim3-v:hasMeasurementUnitIdentifier "kilogram"
        iso-80000-1-v:isBaseUnitFor mass
    ]
}