@dc:description "The ISO-80000-5 library."
@dc:title "ISO-80000-5.1 thermodynamic temperature, kelvin"
description <http://iso.org/iso-80000/5.1-d#> as iso-80000-5.1-d {

    uses <http://www.w3.org/2002/07/owl#> as owl
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://bipm.org/jcgm/vim3-v#> as vim3-v
    uses <http://iso.org/iso-80000/1-v#> as iso-80000-1-v
    uses <http://iso.org/iso-80000/5.1-v#> as iso-80000-5.1-v

    instance theta : vim3-v:BaseDimension [
        vim3-v:hasDimensionSymbol "Θ"
    ]

    instance thermodynamic_temperature : iso-80000-5.1-v:ThermodynamicTemperature [
        vim3-v:hasQuantityIdentifier "thermodynamic temperature"
        vim3-v:hasQuantityDimension : vim3-v:QuantityDimension [
            vim3-v:hasDimensionFactor : vim3-v:BaseDimensionPower [ 
                vim3-v:raisesBaseDimension theta
                vim3-v:toPower "1/1"^^owl:rational
            ]
            vim3-v:hasDimensionSymbol "Θ"
        ]
        iso-80000-1-v:hasDimension theta
    ]

    instance kelvin : iso-80000-5.1-v:ThermodynamicTemperatureUnit [
        vim3-v:hasMeasurementUnitIdentifier "kelvin"
        iso-80000-1-v:isBaseUnitFor thermodynamic_temperature
    ]
}