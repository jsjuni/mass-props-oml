@dc:description "The ISO-80000-4 library."
@dc:title "ISO-80000-4.1 mass, kilgram"
vocabulary <http://iso.org/iso-80000-4.1-v#> as iso-80000-4.1-vocab {

    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://bipm.org/jcgm/vim3-v#> as vim3-v

    uses <http://iso.org/iso-80000-4.1-d#> as iso-80000-4.1-d

    concept MassQuantity = vim3-v:Quantity [
        restricts vim3-v:isSameKindAs to iso-80000-4.1-d:mass
    ]

}