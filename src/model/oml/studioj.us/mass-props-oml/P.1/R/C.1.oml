@dc:creator "http://studioj.us/mass-props-oml/P.1/P#P.1"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/P.1/WP/WP.4#WP.4"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/P.1/R/C.1#> as C.1_R {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://studioj.us/base#> as base
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base1
    uses <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis
    extends <http://studioj.us/mass-props-oml/P.1/C/C.1#> as C.1
    uses <http://studioj.us/metrology#> as metrology
    extends <http://studioj.us/units#> as units

    instance C.1_mass_max : mission:Requirement [
        base:hasRequirementIdentifier "C.1_R.1"
        base1:hasDescription "The System 1 mass shall not exceed 47.39 kg."
        analysis:requires C.1_mass_max_constraint
    ]

    instance C.1_mass_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1:C.1_mass
        analysis:analyzes C.1_mass_max_value
    ]

    instance C.1_mass_max_value : metrology:MassValue [
        metrology:hasNumber 47.39e0
        metrology:hasUnit units:kg
    ]

    instance C.1_Cx_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1_R.Cx_R.2"
        base1:hasDescription "The System 1 Cx shall lie in the interval [-5.12, 16.33] mm."
        analysis:requires C.1_Cx_min_constraint, C.1_Cx_max_constraint
    ]

    instance C.1_Cx_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1:C.1_Cx
        analysis:analyzes C.1_Cx_min_value
    ]

    instance C.1_Cx_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1:C.1_Cx
        analysis:analyzes C.1_Cx_max_value
    ]

    instance C.1_Cx_min_value : metrology:LengthValue [
        metrology:hasNumber -5.12e0
        metrology:hasUnit units:mm
    ]

    instance C.1_Cx_max_value : metrology:LengthValue [
        metrology:hasNumber 16.33e0
        metrology:hasUnit units:mm
    ]

    instance C.1_Cy_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1_R.Cy_R.3"
        base1:hasDescription "The System 1 Cy shall lie in the interval [-2.57, 19.42] mm."
        analysis:requires C.1_Cy_min_constraint, C.1_Cy_max_constraint
    ]

    instance C.1_Cy_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1:C.1_Cy
        analysis:analyzes C.1_Cy_min_value
    ]

    instance C.1_Cy_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1:C.1_Cy
        analysis:analyzes C.1_Cy_max_value
    ]

    instance C.1_Cy_min_value : metrology:LengthValue [
        metrology:hasNumber -2.57e0
        metrology:hasUnit units:mm
    ]

    instance C.1_Cy_max_value : metrology:LengthValue [
        metrology:hasNumber 19.42e0
        metrology:hasUnit units:mm
    ]

    instance C.1_Cz_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1_R.Cz_R.4"
        base1:hasDescription "The System 1 Cz shall lie in the interval [5.74, 27.45] mm."
        analysis:requires C.1_Cz_min_constraint, C.1_Cz_max_constraint
    ]

    instance C.1_Cz_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1:C.1_Cz
        analysis:analyzes C.1_Cz_min_value
    ]

    instance C.1_Cz_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1:C.1_Cz
        analysis:analyzes C.1_Cz_max_value
    ]

    instance C.1_Cz_min_value : metrology:LengthValue [
        metrology:hasNumber 5.74e0
        metrology:hasUnit units:mm
    ]

    instance C.1_Cz_max_value : metrology:LengthValue [
        metrology:hasNumber 27.45e0
        metrology:hasUnit units:mm
    ]
}
