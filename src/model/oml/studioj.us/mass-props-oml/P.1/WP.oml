@dc:creator P.1_P:P.1
description <http://studioj.us/mass-props-oml/P.1/WP#> as P.1_WP {
    uses <http://imce.jpl.nasa.gov/foundation/project#> as project
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base
    uses <http://studioj.us/base#> as base1
    extends <http://studioj.us/mass-props-oml/P.1/C#> as P.1_C
    uses <http://purl.org/dc/elements/1.1/> as dc
    extends <http://studioj.us/mass-props-oml/P.1/P#> as P.1_P

    instance WP.4 : project:WorkPackage [
        base:hasCanonicalName "System 1"
        base1:hasWorkPackageIdentifier "WP.4"
        base:hasSortKey "01"
        project:supplies P.1_C:C.1
    ]
}
