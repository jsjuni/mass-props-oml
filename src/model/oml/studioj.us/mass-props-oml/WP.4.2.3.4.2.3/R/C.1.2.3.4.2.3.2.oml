@dc:creator "http://studioj.us/mass-props-oml/WP.4.2.3.4.2/WP/WP.4.2.3.4.2.3#WP.4.2.3.4.2.3"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/WP.4.2.3.4.2.3/WP/WP.4.2.3.4.2.3.2#WP.4.2.3.4.2.3.2"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/WP.4.2.3.4.2.3/R/C.1.2.3.4.2.3.2#> as C.1.2.3.4.2.3.2_R {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://studioj.us/base#> as base
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base1
    uses <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis
    extends <http://studioj.us/mass-props-oml/WP.4.2.3.4.2.3/C/C.1.2.3.4.2.3.2#> as C.1.2.3.4.2.3.2
    uses <http://studioj.us/metrology#> as metrology
    extends <http://studioj.us/units#> as units

    instance C.1.2.3.4.2.3.2_mass_max : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.2.3.2_R.1"
        base1:hasDescription "The Part 55 mass shall not exceed 0.80 kg."
        analysis:requires C.1.2.3.4.2.3.2_mass_max_constraint
    ]

    instance C.1.2.3.4.2.3.2_mass_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.2.3.2:C.1.2.3.4.2.3.2_mass
        analysis:analyzes C.1.2.3.4.2.3.2_mass_max_value
    ]

    instance C.1.2.3.4.2.3.2_mass_max_value : metrology:MassValue [
        metrology:hasNumber 0.8e0
        metrology:hasUnit units:kg
    ]

    instance C.1.2.3.4.2.3.2_Cx_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.2.3.2_R.Cx_R.2"
        base1:hasDescription "The Part 55 Cx shall lie in the interval [-117.43, -2.09] mm."
        analysis:requires C.1.2.3.4.2.3.2_Cx_min_constraint, C.1.2.3.4.2.3.2_Cx_max_constraint
    ]

    instance C.1.2.3.4.2.3.2_Cx_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4.2.3.2:C.1.2.3.4.2.3.2_Cx
        analysis:analyzes C.1.2.3.4.2.3.2_Cx_min_value
    ]

    instance C.1.2.3.4.2.3.2_Cx_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.2.3.2:C.1.2.3.4.2.3.2_Cx
        analysis:analyzes C.1.2.3.4.2.3.2_Cx_max_value
    ]

    instance C.1.2.3.4.2.3.2_Cx_min_value : metrology:LengthValue [
        metrology:hasNumber -117.43e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.3.2_Cx_max_value : metrology:LengthValue [
        metrology:hasNumber -2.09e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.3.2_Cy_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.2.3.2_R.Cy_R.3"
        base1:hasDescription "The Part 55 Cy shall lie in the interval [-175.27, -58.61] mm."
        analysis:requires C.1.2.3.4.2.3.2_Cy_min_constraint, C.1.2.3.4.2.3.2_Cy_max_constraint
    ]

    instance C.1.2.3.4.2.3.2_Cy_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4.2.3.2:C.1.2.3.4.2.3.2_Cy
        analysis:analyzes C.1.2.3.4.2.3.2_Cy_min_value
    ]

    instance C.1.2.3.4.2.3.2_Cy_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.2.3.2:C.1.2.3.4.2.3.2_Cy
        analysis:analyzes C.1.2.3.4.2.3.2_Cy_max_value
    ]

    instance C.1.2.3.4.2.3.2_Cy_min_value : metrology:LengthValue [
        metrology:hasNumber -175.27e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.3.2_Cy_max_value : metrology:LengthValue [
        metrology:hasNumber -58.61e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.3.2_Cz_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.2.3.2_R.Cz_R.4"
        base1:hasDescription "The Part 55 Cz shall lie in the interval [-164.04, -45.66] mm."
        analysis:requires C.1.2.3.4.2.3.2_Cz_min_constraint, C.1.2.3.4.2.3.2_Cz_max_constraint
    ]

    instance C.1.2.3.4.2.3.2_Cz_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4.2.3.2:C.1.2.3.4.2.3.2_Cz
        analysis:analyzes C.1.2.3.4.2.3.2_Cz_min_value
    ]

    instance C.1.2.3.4.2.3.2_Cz_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.2.3.2:C.1.2.3.4.2.3.2_Cz
        analysis:analyzes C.1.2.3.4.2.3.2_Cz_max_value
    ]

    instance C.1.2.3.4.2.3.2_Cz_min_value : metrology:LengthValue [
        metrology:hasNumber -164.04e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.3.2_Cz_max_value : metrology:LengthValue [
        metrology:hasNumber -45.66e0
        metrology:hasUnit units:mm
    ]
}
