@dc:creator "WP.1.1.1"
description <http://studioj.us/mass-props-oml/WP.1.1.1.1/WP#> as WP.1.1.1.1 {
    uses <http://purl.org/dc/elements/1.1/> as dc
    extends <http://studioj.us/mass-props-oml/WP.1.1.1.1/C#> as c
    uses <http://imce.jpl.nasa.gov/foundation/project#> as project
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base

    instance WP.1.1.1.1.1 : project:WorkPackage [
        base:hasCanonicalName "Assembly 1"
        project:supplies c:C.1.1.1.1.1
    ]

    instance WP.1.1.1.1.2 : project:WorkPackage [
        base:hasCanonicalName "Assembly 2"
        project:supplies c:C.1.1.1.1.2
    ]

    instance WP.1.1.1.1.3 : project:WorkPackage [
        base:hasCanonicalName "Assembly 3"
        project:supplies c:C.1.1.1.1.3
    ]
}
