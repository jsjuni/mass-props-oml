@dc:creator "WP.1"
description <http://studioj.us/mass-props-oml/WP.1/C#> as WP.1_C {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base
    uses <http://studioj.us/metrology#> as metrology

    instance C.1 : mission:Component [
        base:hasCanonicalName "System 1"
        metrology:hasPoiConvention "-"
        metrology:isPointMass false
    ]

    instance C.1.2 : mission:Component [
        base:hasCanonicalName "Segment 2"
        base:isContainedIn C.1
        metrology:hasPoiConvention "-"
        metrology:isPointMass false
    ]

    instance C.1.1 : mission:Component [
        base:hasCanonicalName "Segment 1"
        base:isContainedIn C.1
        metrology:hasPoiConvention "-"
        metrology:isPointMass false
    ]
}
