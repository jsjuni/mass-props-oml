@dc:creator WP.4.1_WP:WP.4.1.1
description <http://studioj.us/mass-props-oml/WP.4.1.1/C#> as WP.4.1.1_C {
    extends <http://studioj.us/mass-props-oml/WP.4.1/C#> as WP.4.1_C
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base
    uses <http://studioj.us/base#> as base1
    uses <http://purl.org/dc/elements/1.1/> as dc
    extends <http://studioj.us/mass-props-oml/WP.4.1/WP#> as WP.4.1_WP

    ref instance WP.4.1_C:C.1.1.1 [
        base:contains C.1.1.1.1, C.1.1.1.2
    ]

    instance C.1.1.1.1 : mission:Component [
        base:hasCanonicalName "Subsystem 1"
        base1:hasComponentIdentifier "C.1.1.1.1"
        base:hasSortKey "01010101"
    ]

    instance C.1.1.1.2 : mission:Component [
        base:hasCanonicalName "Subsystem 2"
        base1:hasComponentIdentifier "C.1.1.1.2"
        base:hasSortKey "01010102"
    ]
}
