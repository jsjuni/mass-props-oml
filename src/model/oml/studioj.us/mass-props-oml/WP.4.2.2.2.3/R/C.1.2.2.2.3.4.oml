@dc:creator "http://studioj.us/mass-props-oml/WP.4.2.2.2/WP/WP.4.2.2.2.3#WP.4.2.2.2.3"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/WP.4.2.2.2.3/WP/WP.4.2.2.2.3.4#WP.4.2.2.2.3.4"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/WP.4.2.2.2.3/R/C.1.2.2.2.3.4#> as C.1.2.2.2.3.4_R {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://studioj.us/base#> as base
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base1
    uses <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis
    extends <http://studioj.us/mass-props-oml/WP.4.2.2.2.3/Q/C.1.2.2.2.3.4#> as C.1.2.2.2.3.4_Q
    uses <http://studioj.us/metrology#> as metrology
    extends <http://studioj.us/units#> as units

    instance C.1.2.2.2.3.4_mass_max : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.2.2.3.4_R.1"
        base1:hasDescription "The Subassembly 7 mass shall not exceed 1.29 kg."
        analysis:requires C.1.2.2.2.3.4_mass_max_constraint
    ]

    instance C.1.2.2.2.3.4_mass_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.2.2.3.4_Q:C.1.2.2.2.3.4_mass
        analysis:analyzes C.1.2.2.2.3.4_mass_max_value
    ]

    instance C.1.2.2.2.3.4_mass_max_value : metrology:MassValue [
        metrology:hasNumber 1.29e0
        metrology:hasUnit units:kg
    ]

    instance C.1.2.2.2.3.4_Cx_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.2.2.3.4_R.Cx_R.2"
        base1:hasDescription "The Subassembly 7 Cx shall lie in the interval [-121.84, -6.51] mm."
        analysis:requires C.1.2.2.2.3.4_Cx_min_constraint, C.1.2.2.2.3.4_Cx_max_constraint
    ]

    instance C.1.2.2.2.3.4_Cx_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.2.2.3.4_Q:C.1.2.2.2.3.4_Cx
        analysis:analyzes C.1.2.2.2.3.4_Cx_min_value
    ]

    instance C.1.2.2.2.3.4_Cx_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.2.2.3.4_Q:C.1.2.2.2.3.4_Cx
        analysis:analyzes C.1.2.2.2.3.4_Cx_max_value
    ]

    instance C.1.2.2.2.3.4_Cx_min_value : metrology:LengthValue [
        metrology:hasNumber -121.84e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.2.3.4_Cx_max_value : metrology:LengthValue [
        metrology:hasNumber -6.51e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.2.3.4_Cy_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.2.2.3.4_R.Cy_R.3"
        base1:hasDescription "The Subassembly 7 Cy shall lie in the interval [8.68, 125.33] mm."
        analysis:requires C.1.2.2.2.3.4_Cy_min_constraint, C.1.2.2.2.3.4_Cy_max_constraint
    ]

    instance C.1.2.2.2.3.4_Cy_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.2.2.3.4_Q:C.1.2.2.2.3.4_Cy
        analysis:analyzes C.1.2.2.2.3.4_Cy_min_value
    ]

    instance C.1.2.2.2.3.4_Cy_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.2.2.3.4_Q:C.1.2.2.2.3.4_Cy
        analysis:analyzes C.1.2.2.2.3.4_Cy_max_value
    ]

    instance C.1.2.2.2.3.4_Cy_min_value : metrology:LengthValue [
        metrology:hasNumber 8.68e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.2.3.4_Cy_max_value : metrology:LengthValue [
        metrology:hasNumber 125.33e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.2.3.4_Cz_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.2.2.3.4_R.Cz_R.4"
        base1:hasDescription "The Subassembly 7 Cz shall lie in the interval [-132.25, -13.87] mm."
        analysis:requires C.1.2.2.2.3.4_Cz_min_constraint, C.1.2.2.2.3.4_Cz_max_constraint
    ]

    instance C.1.2.2.2.3.4_Cz_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.2.2.3.4_Q:C.1.2.2.2.3.4_Cz
        analysis:analyzes C.1.2.2.2.3.4_Cz_min_value
    ]

    instance C.1.2.2.2.3.4_Cz_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.2.2.3.4_Q:C.1.2.2.2.3.4_Cz
        analysis:analyzes C.1.2.2.2.3.4_Cz_max_value
    ]

    instance C.1.2.2.2.3.4_Cz_min_value : metrology:LengthValue [
        metrology:hasNumber -132.25e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.2.3.4_Cz_max_value : metrology:LengthValue [
        metrology:hasNumber -13.87e0
        metrology:hasUnit units:mm
    ]
}
