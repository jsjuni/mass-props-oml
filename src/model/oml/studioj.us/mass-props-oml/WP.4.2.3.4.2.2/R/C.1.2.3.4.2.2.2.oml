@dc:creator "http://studioj.us/mass-props-oml/WP.4.2.3.4.2/WP/WP.4.2.3.4.2.2#WP.4.2.3.4.2.2"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/WP.4.2.3.4.2.2/WP/WP.4.2.3.4.2.2.2#WP.4.2.3.4.2.2.2"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/WP.4.2.3.4.2.2/R/C.1.2.3.4.2.2.2#> as C.1.2.3.4.2.2.2_R {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://studioj.us/base#> as base
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base1
    uses <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis
    extends <http://studioj.us/mass-props-oml/WP.4.2.3.4.2.2/C/C.1.2.3.4.2.2.2#> as C.1.2.3.4.2.2.2
    uses <http://studioj.us/metrology#> as metrology
    extends <http://studioj.us/units#> as units

    instance C.1.2.3.4.2.2.2_mass_max : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.2.2.2_R.1"
        base1:hasDescription "The Part 51 mass shall not exceed 0.99 kg."
        analysis:requires C.1.2.3.4.2.2.2_mass_max_constraint
    ]

    instance C.1.2.3.4.2.2.2_mass_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.2.2.2:C.1.2.3.4.2.2.2_mass
        analysis:analyzes C.1.2.3.4.2.2.2_mass_max_value
    ]

    instance C.1.2.3.4.2.2.2_mass_max_value : metrology:MassValue [
        metrology:hasNumber 0.99e0
        metrology:hasUnit units:kg
    ]

    instance C.1.2.3.4.2.2.2_Cx_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.2.2.2_R.Cx_R.2"
        base1:hasDescription "The Part 51 Cx shall lie in the interval [-173.82, -58.48] mm."
        analysis:requires C.1.2.3.4.2.2.2_Cx_min_constraint, C.1.2.3.4.2.2.2_Cx_max_constraint
    ]

    instance C.1.2.3.4.2.2.2_Cx_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4.2.2.2:C.1.2.3.4.2.2.2_Cx
        analysis:analyzes C.1.2.3.4.2.2.2_Cx_min_value
    ]

    instance C.1.2.3.4.2.2.2_Cx_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.2.2.2:C.1.2.3.4.2.2.2_Cx
        analysis:analyzes C.1.2.3.4.2.2.2_Cx_max_value
    ]

    instance C.1.2.3.4.2.2.2_Cx_min_value : metrology:LengthValue [
        metrology:hasNumber -173.82e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.2.2_Cx_max_value : metrology:LengthValue [
        metrology:hasNumber -58.48e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.2.2_Cy_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.2.2.2_R.Cy_R.3"
        base1:hasDescription "The Part 51 Cy shall lie in the interval [-3.65, 113.00] mm."
        analysis:requires C.1.2.3.4.2.2.2_Cy_min_constraint, C.1.2.3.4.2.2.2_Cy_max_constraint
    ]

    instance C.1.2.3.4.2.2.2_Cy_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4.2.2.2:C.1.2.3.4.2.2.2_Cy
        analysis:analyzes C.1.2.3.4.2.2.2_Cy_min_value
    ]

    instance C.1.2.3.4.2.2.2_Cy_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.2.2.2:C.1.2.3.4.2.2.2_Cy
        analysis:analyzes C.1.2.3.4.2.2.2_Cy_max_value
    ]

    instance C.1.2.3.4.2.2.2_Cy_min_value : metrology:LengthValue [
        metrology:hasNumber -3.65e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.2.2_Cy_max_value : metrology:LengthValue [
        metrology:hasNumber 113.0e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.2.2_Cz_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.2.2.2_R.Cz_R.4"
        base1:hasDescription "The Part 51 Cz shall lie in the interval [95.95, 214.33] mm."
        analysis:requires C.1.2.3.4.2.2.2_Cz_min_constraint, C.1.2.3.4.2.2.2_Cz_max_constraint
    ]

    instance C.1.2.3.4.2.2.2_Cz_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4.2.2.2:C.1.2.3.4.2.2.2_Cz
        analysis:analyzes C.1.2.3.4.2.2.2_Cz_min_value
    ]

    instance C.1.2.3.4.2.2.2_Cz_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.2.2.2:C.1.2.3.4.2.2.2_Cz
        analysis:analyzes C.1.2.3.4.2.2.2_Cz_max_value
    ]

    instance C.1.2.3.4.2.2.2_Cz_min_value : metrology:LengthValue [
        metrology:hasNumber 95.95e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.2.2_Cz_max_value : metrology:LengthValue [
        metrology:hasNumber 214.33e0
        metrology:hasUnit units:mm
    ]
}
