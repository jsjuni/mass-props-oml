@dc:creator "WP.1.2.2"
description <http://studioj.us/mass-props-oml/WP.1.2.2.3/WP#> as WP.1.2.2.3 {
    uses <http://purl.org/dc/elements/1.1/> as dc
    extends <http://studioj.us/mass-props-oml/WP.1.2.2.3/C#> as c
    uses <http://imce.jpl.nasa.gov/foundation/project#> as project
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base

    instance WP.1.2.2.3.1 : project:WorkPackage [
        base:hasCanonicalName "Assembly 81"
        project:supplies c:C.1.2.2.3.1
    ]

    instance WP.1.2.2.3.2 : project:WorkPackage [
        base:hasCanonicalName "Assembly 82"
        project:supplies c:C.1.2.2.3.2
    ]
}
