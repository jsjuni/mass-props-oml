@dc:creator "WP.1.2"
description <http://studioj.us/mass-props-oml/WP.1.2.2/WP#> as WP.1.2.2 {
    uses <http://purl.org/dc/elements/1.1/> as dc
    extends <http://studioj.us/mass-props-oml/WP.1.2.2/C#> as c
    uses <http://imce.jpl.nasa.gov/foundation/project#> as project
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base

    instance WP.1.2.2.3 : project:WorkPackage [
        base:hasCanonicalName "Subsystem 22"
        project:supplies c:C.1.2.2.3
    ]

    instance WP.1.2.2.1 : project:WorkPackage [
        base:hasCanonicalName "Subsystem 20"
        project:supplies c:C.1.2.2.1
    ]

    instance WP.1.2.2.2 : project:WorkPackage [
        base:hasCanonicalName "Subsystem 21"
        project:supplies c:C.1.2.2.2
    ]
}
