@dc:creator "http://studioj.us/mass-props-oml/P.1/WP/WP.4#WP.4"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/P.1/P#P.1"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/WP.4/QV#> as WP.4_QV {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    uses <http://www.w3.org/2000/01/rdf-schema#> as rdfs
    uses <http://studioj.us/mass-properties#> as mass-properties
    uses <http://bipm.org/jcgm/vim3-v#> as vim3-v
    extends <http://studioj.us/mass-props-oml/P.1/Q/C.1#> as C.1_Q
    extends <http://studioj.us/mass-props-oml/P.1/C/C.1#> as C.1

    @rdfs:label "mass"
    instance C.1_mass_value : mass-properties:MassValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_mass
    ]

    @rdfs:label "Cx"
    instance C.1_Cx_value : mass-properties:CenterOfMassCoordinateValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_Cx
    ]

    @rdfs:label "Cy"
    instance C.1_Cy_value : mass-properties:CenterOfMassCoordinateValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_Cy
    ]

    @rdfs:label "Cz"
    instance C.1_Cz_value : mass-properties:CenterOfMassCoordinateValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_Cz
    ]

    @rdfs:label "Ixx"
    instance C.1_Ixx_value : mass-properties:MomentOfInertiaValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_Ixx
    ]

    @rdfs:label "Iyy"
    instance C.1_Iyy_value : mass-properties:MomentOfInertiaValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_Iyy
    ]

    @rdfs:label "Izz"
    instance C.1_Izz_value : mass-properties:MomentOfInertiaValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_Izz
    ]

    @rdfs:label "Ixy"
    instance C.1_Ixy_value : mass-properties:ProductOfInertiaValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_Ixy
    ]

    @rdfs:label "Ixz"
    instance C.1_Ixz_value : mass-properties:ProductOfInertiaValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_Ixz
    ]

    @rdfs:label "Iyz"
    instance C.1_Iyz_value : mass-properties:ProductOfInertiaValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_Iyz
    ]

    @rdfs:label "sigma_mass"
    instance C.1_sigma_mass_value : mass-properties:MassValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_sigma_mass
    ]

    @rdfs:label "sigma_Cx"
    instance C.1_sigma_Cx_value : mass-properties:CenterOfMassCoordinateValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_sigma_Cx
    ]

    @rdfs:label "sigma_Cy"
    instance C.1_sigma_Cy_value : mass-properties:CenterOfMassCoordinateValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_sigma_Cy
    ]

    @rdfs:label "sigma_Cz"
    instance C.1_sigma_Cz_value : mass-properties:CenterOfMassCoordinateValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_sigma_Cz
    ]

    @rdfs:label "sigma_Ixx"
    instance C.1_sigma_Ixx_value : mass-properties:MomentOfInertiaValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_sigma_Ixx
    ]

    @rdfs:label "sigma_Iyy"
    instance C.1_sigma_Iyy_value : mass-properties:MomentOfInertiaValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_sigma_Iyy
    ]

    @rdfs:label "sigma_Izz"
    instance C.1_sigma_Izz_value : mass-properties:MomentOfInertiaValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_sigma_Izz
    ]

    @rdfs:label "sigma_Ixy"
    instance C.1_sigma_Ixy_value : mass-properties:ProductOfInertiaValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_sigma_Ixy
    ]

    @rdfs:label "sigma_Ixz"
    instance C.1_sigma_Ixz_value : mass-properties:ProductOfInertiaValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_sigma_Ixz
    ]

    @rdfs:label "sigma_Iyz"
    instance C.1_sigma_Iyz_value : mass-properties:ProductOfInertiaValue [
        vim3-v:expressesMagnitudeOf C.1_Q:C.1_sigma_Iyz
    ]

    ref instance C.1:C.1 [
        mass-properties:hasPoiConvention "-"
        mass-properties:isPointMass false
    ]
}
