@dc:creator "http://studioj.us/mass-props-oml/P.1/WP/WP.4#WP.4"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/WP.4/WP/WP.4.2#WP.4.2"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/WP.4/IF/C.1.2#> as C.1.2_IF {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    extends <http://studioj.us/mass-props-oml/WP.4/C/C.1.2#> as C.1.2
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://studioj.us/base#> as base
    extends <http://studioj.us/mass-props-oml/WP.4/IT/IT.C.1.1_out#> as IT.C.1.1_out
    extends <http://studioj.us/mass-props-oml/WP.4/IT/IT.C.1.2_out#> as IT.C.1.2_out

    ref instance C.1.2:C.1.2 [
        mission:presents IF.C.1.2_in, IF.C.1.2_out
    ]

    instance IF.C.1.2_in : mission:Interface [
        base:hasInterfaceIdentifier "IF.C.1.2_in"
        mission:transfersIn IT.C.1.1_out:IT.C.1.1_out
    ]

    instance IF.C.1.2_out : mission:Interface [
        base:hasInterfaceIdentifier "IF.C.1.2_out"
        mission:transfersOut IT.C.1.2_out:IT.C.1.2_out
    ]
}
