@dc:creator "http://studioj.us/mass-props-oml/P.1/WP/WP.4#WP.4"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/WP.4/WP/WP.4.3#WP.4.3"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/WP.4/R/C.1.3#> as C.1.3_R {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://studioj.us/base#> as base
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base1
    uses <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis
    extends <http://studioj.us/mass-props-oml/WP.4/Q/C.1.3#> as C.1.3_Q
    uses <http://studioj.us/metrology#> as metrology
    extends <http://studioj.us/units#> as units

    instance C.1.3_mass_max : mission:Requirement [
        base:hasRequirementIdentifier "C.1.3_R.1"
        base1:hasDescription "The Segment 3 mass shall not exceed 0.76 kg."
        analysis:requires C.1.3_mass_max_constraint
    ]

    instance C.1.3_mass_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.3_Q:C.1.3_mass
        analysis:analyzes C.1.3_mass_max_value
    ]

    instance C.1.3_mass_max_value : metrology:MassValue [
        metrology:hasNumber 0.76e0
        metrology:hasUnit units:kg
    ]

    instance C.1.3_Cx_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.3_R.Cx_R.2"
        base1:hasDescription "The Segment 3 Cx shall lie in the interval [-15.44, 99.90] mm."
        analysis:requires C.1.3_Cx_min_constraint, C.1.3_Cx_max_constraint
    ]

    instance C.1.3_Cx_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.3_Q:C.1.3_Cx
        analysis:analyzes C.1.3_Cx_min_value
    ]

    instance C.1.3_Cx_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.3_Q:C.1.3_Cx
        analysis:analyzes C.1.3_Cx_max_value
    ]

    instance C.1.3_Cx_min_value : metrology:LengthValue [
        metrology:hasNumber -15.44e0
        metrology:hasUnit units:mm
    ]

    instance C.1.3_Cx_max_value : metrology:LengthValue [
        metrology:hasNumber 99.9e0
        metrology:hasUnit units:mm
    ]

    instance C.1.3_Cy_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.3_R.Cy_R.3"
        base1:hasDescription "The Segment 3 Cy shall lie in the interval [-4.80, 111.85] mm."
        analysis:requires C.1.3_Cy_min_constraint, C.1.3_Cy_max_constraint
    ]

    instance C.1.3_Cy_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.3_Q:C.1.3_Cy
        analysis:analyzes C.1.3_Cy_min_value
    ]

    instance C.1.3_Cy_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.3_Q:C.1.3_Cy
        analysis:analyzes C.1.3_Cy_max_value
    ]

    instance C.1.3_Cy_min_value : metrology:LengthValue [
        metrology:hasNumber -4.8e0
        metrology:hasUnit units:mm
    ]

    instance C.1.3_Cy_max_value : metrology:LengthValue [
        metrology:hasNumber 111.85e0
        metrology:hasUnit units:mm
    ]

    instance C.1.3_Cz_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.3_R.Cz_R.4"
        base1:hasDescription "The Segment 3 Cz shall lie in the interval [-91.25, 27.13] mm."
        analysis:requires C.1.3_Cz_min_constraint, C.1.3_Cz_max_constraint
    ]

    instance C.1.3_Cz_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.3_Q:C.1.3_Cz
        analysis:analyzes C.1.3_Cz_min_value
    ]

    instance C.1.3_Cz_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.3_Q:C.1.3_Cz
        analysis:analyzes C.1.3_Cz_max_value
    ]

    instance C.1.3_Cz_min_value : metrology:LengthValue [
        metrology:hasNumber -91.25e0
        metrology:hasUnit units:mm
    ]

    instance C.1.3_Cz_max_value : metrology:LengthValue [
        metrology:hasNumber 27.13e0
        metrology:hasUnit units:mm
    ]
}
