@dc:creator "WP.1"
description <http://studioj.us/mass-props-oml/WP.1.1/C#> as WP.1.1_C {
    uses <http://purl.org/dc/elements/1.1/> as dc
    extends <http://studioj.us/mass-props-oml/WP.1/C#> as WP.1_C
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base
    uses <http://studioj.us/metrology#> as metrology

    instance C.1.1.1 : mission:Component [
        base:hasCanonicalName "Element 1"
        base:isContainedIn WP.1_C:C.1.1
        metrology:hasPoiConvention "-"
        metrology:isPointMass false
    ]

    instance C.1.1.2 : mission:Component [
        base:hasCanonicalName "Element 2"
        base:isContainedIn WP.1_C:C.1.1
        metrology:hasPoiConvention "-"
        metrology:isPointMass false
    ]

    instance C.1.1.4 : mission:Component [
        base:hasCanonicalName "Element 4"
        base:isContainedIn WP.1_C:C.1.1
        metrology:hasPoiConvention "-"
        metrology:isPointMass false
    ]

    instance C.1.1.3 : mission:Component [
        base:hasCanonicalName "Element 3"
        base:isContainedIn WP.1_C:C.1.1
        metrology:hasPoiConvention "-"
        metrology:isPointMass false
    ]
}
