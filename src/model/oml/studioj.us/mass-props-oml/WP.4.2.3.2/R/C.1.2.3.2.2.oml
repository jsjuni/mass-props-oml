@dc:creator "http://studioj.us/mass-props-oml/WP.4.2.3/WP/WP.4.2.3.2#WP.4.2.3.2"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/WP.4.2.3.2/WP/WP.4.2.3.2.2#WP.4.2.3.2.2"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/WP.4.2.3.2/R/C.1.2.3.2.2#> as C.1.2.3.2.2_R {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://studioj.us/base#> as base
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base1
    uses <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis
    extends <http://studioj.us/mass-props-oml/WP.4.2.3.2/C/C.1.2.3.2.2#> as C.1.2.3.2.2
    uses <http://studioj.us/metrology#> as metrology
    extends <http://studioj.us/units#> as units

    instance C.1.2.3.2.2_mass_max : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.2.2_R.1"
        base1:hasDescription "The Assembly 13 mass shall not exceed 5.68 kg."
        analysis:requires C.1.2.3.2.2_mass_max_constraint
    ]

    instance C.1.2.3.2.2_mass_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.2.2:C.1.2.3.2.2_mass
        analysis:analyzes C.1.2.3.2.2_mass_max_value
    ]

    instance C.1.2.3.2.2_mass_max_value : metrology:MassValue [
        metrology:hasNumber 5.68e0
        metrology:hasUnit units:kg
    ]

    instance C.1.2.3.2.2_Cx_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.2.2_R.Cx_R.2"
        base1:hasDescription "The Assembly 13 Cx shall lie in the interval [-35.64, 38.01] mm."
        analysis:requires C.1.2.3.2.2_Cx_min_constraint, C.1.2.3.2.2_Cx_max_constraint
    ]

    instance C.1.2.3.2.2_Cx_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.2.2:C.1.2.3.2.2_Cx
        analysis:analyzes C.1.2.3.2.2_Cx_min_value
    ]

    instance C.1.2.3.2.2_Cx_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.2.2:C.1.2.3.2.2_Cx
        analysis:analyzes C.1.2.3.2.2_Cx_max_value
    ]

    instance C.1.2.3.2.2_Cx_min_value : metrology:LengthValue [
        metrology:hasNumber -35.64e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.2.2_Cx_max_value : metrology:LengthValue [
        metrology:hasNumber 38.01e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.2.2_Cy_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.2.2_R.Cy_R.3"
        base1:hasDescription "The Assembly 13 Cy shall lie in the interval [43.56, 96.36] mm."
        analysis:requires C.1.2.3.2.2_Cy_min_constraint, C.1.2.3.2.2_Cy_max_constraint
    ]

    instance C.1.2.3.2.2_Cy_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.2.2:C.1.2.3.2.2_Cy
        analysis:analyzes C.1.2.3.2.2_Cy_min_value
    ]

    instance C.1.2.3.2.2_Cy_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.2.2:C.1.2.3.2.2_Cy
        analysis:analyzes C.1.2.3.2.2_Cy_max_value
    ]

    instance C.1.2.3.2.2_Cy_min_value : metrology:LengthValue [
        metrology:hasNumber 43.56e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.2.2_Cy_max_value : metrology:LengthValue [
        metrology:hasNumber 96.36e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.2.2_Cz_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.2.2_R.Cz_R.4"
        base1:hasDescription "The Assembly 13 Cz shall lie in the interval [-58.62, 3.63] mm."
        analysis:requires C.1.2.3.2.2_Cz_min_constraint, C.1.2.3.2.2_Cz_max_constraint
    ]

    instance C.1.2.3.2.2_Cz_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.2.2:C.1.2.3.2.2_Cz
        analysis:analyzes C.1.2.3.2.2_Cz_min_value
    ]

    instance C.1.2.3.2.2_Cz_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.2.2:C.1.2.3.2.2_Cz
        analysis:analyzes C.1.2.3.2.2_Cz_max_value
    ]

    instance C.1.2.3.2.2_Cz_min_value : metrology:LengthValue [
        metrology:hasNumber -58.62e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.2.2_Cz_max_value : metrology:LengthValue [
        metrology:hasNumber 3.63e0
        metrology:hasUnit units:mm
    ]
}
