@dc:creator "WP.1.1"
description <http://studioj.us/mass-props-oml/WP.1.1.2/C#> as WP.1.1.2_C {
    uses <http://purl.org/dc/elements/1.1/> as dc
    extends <http://studioj.us/mass-props-oml/WP.1.1/C#> as WP.1.1_C
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base

    instance C.1.1.2.2 : mission:Component [
        base:hasCanonicalName "Subsystem 4"
        base:isContainedIn WP.1.1_C:C.1.1.2
    ]

    instance C.1.1.2.1 : mission:Component [
        base:hasCanonicalName "Subsystem 3"
        base:isContainedIn WP.1.1_C:C.1.1.2
    ]

    instance C.1.1.2.3 : mission:Component [
        base:hasCanonicalName "Subsystem 5"
        base:isContainedIn WP.1.1_C:C.1.1.2
    ]
}
