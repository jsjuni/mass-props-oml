@dc:creator "http://studioj.us/mass-props-oml/WP.4.2.3.4/WP/WP.4.2.3.4.3#WP.4.2.3.4.3"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/WP.4.2.3.4.3/WP/WP.4.2.3.4.3.1#WP.4.2.3.4.3.1"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/WP.4.2.3.4.3/R/C.1.2.3.4.3.1#> as C.1.2.3.4.3.1_R {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://studioj.us/base#> as base
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base1
    uses <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis
    extends <http://studioj.us/mass-props-oml/WP.4.2.3.4.3/C/C.1.2.3.4.3.1#> as C.1.2.3.4.3.1
    uses <http://studioj.us/metrology#> as metrology
    extends <http://studioj.us/units#> as units

    instance C.1.2.3.4.3.1_mass_max : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.3.1_R.1"
        base1:hasDescription "The Subassembly 31 mass shall not exceed 1.36 kg."
        analysis:requires C.1.2.3.4.3.1_mass_max_constraint
    ]

    instance C.1.2.3.4.3.1_mass_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.3.1:C.1.2.3.4.3.1_mass
        analysis:analyzes C.1.2.3.4.3.1_mass_max_value
    ]

    instance C.1.2.3.4.3.1_mass_max_value : metrology:MassValue [
        metrology:hasNumber 1.36e0
        metrology:hasUnit units:kg
    ]

    instance C.1.2.3.4.3.1_Cx_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.3.1_R.Cx_R.2"
        base1:hasDescription "The Subassembly 31 Cx shall lie in the interval [-86.46, 28.87] mm."
        analysis:requires C.1.2.3.4.3.1_Cx_min_constraint, C.1.2.3.4.3.1_Cx_max_constraint
    ]

    instance C.1.2.3.4.3.1_Cx_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4.3.1:C.1.2.3.4.3.1_Cx
        analysis:analyzes C.1.2.3.4.3.1_Cx_min_value
    ]

    instance C.1.2.3.4.3.1_Cx_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.3.1:C.1.2.3.4.3.1_Cx
        analysis:analyzes C.1.2.3.4.3.1_Cx_max_value
    ]

    instance C.1.2.3.4.3.1_Cx_min_value : metrology:LengthValue [
        metrology:hasNumber -86.46e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.3.1_Cx_max_value : metrology:LengthValue [
        metrology:hasNumber 28.87e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.3.1_Cy_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.3.1_R.Cy_R.3"
        base1:hasDescription "The Subassembly 31 Cy shall lie in the interval [23.14, 139.80] mm."
        analysis:requires C.1.2.3.4.3.1_Cy_min_constraint, C.1.2.3.4.3.1_Cy_max_constraint
    ]

    instance C.1.2.3.4.3.1_Cy_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4.3.1:C.1.2.3.4.3.1_Cy
        analysis:analyzes C.1.2.3.4.3.1_Cy_min_value
    ]

    instance C.1.2.3.4.3.1_Cy_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.3.1:C.1.2.3.4.3.1_Cy
        analysis:analyzes C.1.2.3.4.3.1_Cy_max_value
    ]

    instance C.1.2.3.4.3.1_Cy_min_value : metrology:LengthValue [
        metrology:hasNumber 23.14e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.3.1_Cy_max_value : metrology:LengthValue [
        metrology:hasNumber 139.8e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.3.1_Cz_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.3.1_R.Cz_R.4"
        base1:hasDescription "The Subassembly 31 Cz shall lie in the interval [-19.82, 98.56] mm."
        analysis:requires C.1.2.3.4.3.1_Cz_min_constraint, C.1.2.3.4.3.1_Cz_max_constraint
    ]

    instance C.1.2.3.4.3.1_Cz_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4.3.1:C.1.2.3.4.3.1_Cz
        analysis:analyzes C.1.2.3.4.3.1_Cz_min_value
    ]

    instance C.1.2.3.4.3.1_Cz_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.3.1:C.1.2.3.4.3.1_Cz
        analysis:analyzes C.1.2.3.4.3.1_Cz_max_value
    ]

    instance C.1.2.3.4.3.1_Cz_min_value : metrology:LengthValue [
        metrology:hasNumber -19.82e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.3.1_Cz_max_value : metrology:LengthValue [
        metrology:hasNumber 98.56e0
        metrology:hasUnit units:mm
    ]
}
