@dc:creator "http://studioj.us/mass-props-oml/WP.4.2.2/WP/WP.4.2.2.2#WP.4.2.2.2"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/WP.4.2.2.2/WP/WP.4.2.2.2.2#WP.4.2.2.2.2"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/WP.4.2.2.2/R/C.1.2.2.2.2#> as C.1.2.2.2.2_R {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://studioj.us/base#> as base
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base1
    uses <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis
    extends <http://studioj.us/mass-props-oml/WP.4.2.2.2/Q/C.1.2.2.2.2#> as C.1.2.2.2.2_Q
    uses <http://studioj.us/metrology#> as metrology
    extends <http://studioj.us/units#> as units

    instance C.1.2.2.2.2_mass_max : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.2.2.2_R.1"
        base1:hasDescription "The Assembly 2 mass shall not exceed 4.05 kg."
        analysis:requires C.1.2.2.2.2_mass_max_constraint
    ]

    instance C.1.2.2.2.2_mass_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.2.2.2_Q:C.1.2.2.2.2_mass
        analysis:analyzes C.1.2.2.2.2_mass_max_value
    ]

    instance C.1.2.2.2.2_mass_max_value : metrology:MassValue [
        metrology:hasNumber 4.05e0
        metrology:hasUnit units:kg
    ]

    instance C.1.2.2.2.2_Cx_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.2.2.2_R.Cx_R.2"
        base1:hasDescription "The Assembly 2 Cx shall lie in the interval [-55.54, 29.59] mm."
        analysis:requires C.1.2.2.2.2_Cx_min_constraint, C.1.2.2.2.2_Cx_max_constraint
    ]

    instance C.1.2.2.2.2_Cx_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.2.2.2_Q:C.1.2.2.2.2_Cx
        analysis:analyzes C.1.2.2.2.2_Cx_min_value
    ]

    instance C.1.2.2.2.2_Cx_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.2.2.2_Q:C.1.2.2.2.2_Cx
        analysis:analyzes C.1.2.2.2.2_Cx_max_value
    ]

    instance C.1.2.2.2.2_Cx_min_value : metrology:LengthValue [
        metrology:hasNumber -55.54e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.2.2_Cx_max_value : metrology:LengthValue [
        metrology:hasNumber 29.59e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.2.2_Cy_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.2.2.2_R.Cy_R.3"
        base1:hasDescription "The Assembly 2 Cy shall lie in the interval [-10.40, 84.60] mm."
        analysis:requires C.1.2.2.2.2_Cy_min_constraint, C.1.2.2.2.2_Cy_max_constraint
    ]

    instance C.1.2.2.2.2_Cy_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.2.2.2_Q:C.1.2.2.2.2_Cy
        analysis:analyzes C.1.2.2.2.2_Cy_min_value
    ]

    instance C.1.2.2.2.2_Cy_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.2.2.2_Q:C.1.2.2.2.2_Cy
        analysis:analyzes C.1.2.2.2.2_Cy_max_value
    ]

    instance C.1.2.2.2.2_Cy_min_value : metrology:LengthValue [
        metrology:hasNumber -10.4e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.2.2_Cy_max_value : metrology:LengthValue [
        metrology:hasNumber 84.6e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.2.2_Cz_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.2.2.2_R.Cz_R.4"
        base1:hasDescription "The Assembly 2 Cz shall lie in the interval [-90.17, -15.40] mm."
        analysis:requires C.1.2.2.2.2_Cz_min_constraint, C.1.2.2.2.2_Cz_max_constraint
    ]

    instance C.1.2.2.2.2_Cz_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.2.2.2_Q:C.1.2.2.2.2_Cz
        analysis:analyzes C.1.2.2.2.2_Cz_min_value
    ]

    instance C.1.2.2.2.2_Cz_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.2.2.2_Q:C.1.2.2.2.2_Cz
        analysis:analyzes C.1.2.2.2.2_Cz_max_value
    ]

    instance C.1.2.2.2.2_Cz_min_value : metrology:LengthValue [
        metrology:hasNumber -90.17e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.2.2_Cz_max_value : metrology:LengthValue [
        metrology:hasNumber -15.4e0
        metrology:hasUnit units:mm
    ]
}
