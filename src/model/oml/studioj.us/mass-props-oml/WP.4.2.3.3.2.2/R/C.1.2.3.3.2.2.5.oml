@dc:creator "http://studioj.us/mass-props-oml/WP.4.2.3.3.2/WP/WP.4.2.3.3.2.2#WP.4.2.3.3.2.2"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/WP.4.2.3.3.2.2/WP/WP.4.2.3.3.2.2.5#WP.4.2.3.3.2.2.5"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/WP.4.2.3.3.2.2/R/C.1.2.3.3.2.2.5#> as C.1.2.3.3.2.2.5_R {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://studioj.us/base#> as base
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base1
    uses <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis
    extends <http://studioj.us/mass-props-oml/WP.4.2.3.3.2.2/C/C.1.2.3.3.2.2.5#> as C.1.2.3.3.2.2.5
    uses <http://studioj.us/metrology#> as metrology
    extends <http://studioj.us/units#> as units

    instance C.1.2.3.3.2.2.5_mass_max : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.3.2.2.5_R.1"
        base1:hasDescription "The Part 46 mass shall not exceed 0.88 kg."
        analysis:requires C.1.2.3.3.2.2.5_mass_max_constraint
    ]

    instance C.1.2.3.3.2.2.5_mass_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.3.2.2.5:C.1.2.3.3.2.2.5_mass
        analysis:analyzes C.1.2.3.3.2.2.5_mass_max_value
    ]

    instance C.1.2.3.3.2.2.5_mass_max_value : metrology:MassValue [
        metrology:hasNumber 0.88e0
        metrology:hasUnit units:kg
    ]

    instance C.1.2.3.3.2.2.5_Cx_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.3.2.2.5_R.Cx_R.2"
        base1:hasDescription "The Part 46 Cx shall lie in the interval [-154.82, -39.49] mm."
        analysis:requires C.1.2.3.3.2.2.5_Cx_min_constraint, C.1.2.3.3.2.2.5_Cx_max_constraint
    ]

    instance C.1.2.3.3.2.2.5_Cx_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.3.2.2.5:C.1.2.3.3.2.2.5_Cx
        analysis:analyzes C.1.2.3.3.2.2.5_Cx_min_value
    ]

    instance C.1.2.3.3.2.2.5_Cx_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.3.2.2.5:C.1.2.3.3.2.2.5_Cx
        analysis:analyzes C.1.2.3.3.2.2.5_Cx_max_value
    ]

    instance C.1.2.3.3.2.2.5_Cx_min_value : metrology:LengthValue [
        metrology:hasNumber -154.82e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.3.2.2.5_Cx_max_value : metrology:LengthValue [
        metrology:hasNumber -39.49e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.3.2.2.5_Cy_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.3.2.2.5_R.Cy_R.3"
        base1:hasDescription "The Part 46 Cy shall lie in the interval [-161.32, -44.67] mm."
        analysis:requires C.1.2.3.3.2.2.5_Cy_min_constraint, C.1.2.3.3.2.2.5_Cy_max_constraint
    ]

    instance C.1.2.3.3.2.2.5_Cy_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.3.2.2.5:C.1.2.3.3.2.2.5_Cy
        analysis:analyzes C.1.2.3.3.2.2.5_Cy_min_value
    ]

    instance C.1.2.3.3.2.2.5_Cy_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.3.2.2.5:C.1.2.3.3.2.2.5_Cy
        analysis:analyzes C.1.2.3.3.2.2.5_Cy_max_value
    ]

    instance C.1.2.3.3.2.2.5_Cy_min_value : metrology:LengthValue [
        metrology:hasNumber -161.32e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.3.2.2.5_Cy_max_value : metrology:LengthValue [
        metrology:hasNumber -44.67e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.3.2.2.5_Cz_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.3.2.2.5_R.Cz_R.4"
        base1:hasDescription "The Part 46 Cz shall lie in the interval [0.82, 119.20] mm."
        analysis:requires C.1.2.3.3.2.2.5_Cz_min_constraint, C.1.2.3.3.2.2.5_Cz_max_constraint
    ]

    instance C.1.2.3.3.2.2.5_Cz_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.3.2.2.5:C.1.2.3.3.2.2.5_Cz
        analysis:analyzes C.1.2.3.3.2.2.5_Cz_min_value
    ]

    instance C.1.2.3.3.2.2.5_Cz_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.3.2.2.5:C.1.2.3.3.2.2.5_Cz
        analysis:analyzes C.1.2.3.3.2.2.5_Cz_max_value
    ]

    instance C.1.2.3.3.2.2.5_Cz_min_value : metrology:LengthValue [
        metrology:hasNumber 0.82e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.3.2.2.5_Cz_max_value : metrology:LengthValue [
        metrology:hasNumber 119.2e0
        metrology:hasUnit units:mm
    ]
}
