@dc:creator "http://studioj.us/mass-props-oml/WP.4.2.2.4.3/WP/WP.4.2.2.4.3.4#WP.4.2.2.4.3.4"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/WP.4.2.2.4.3.4/WP/WP.4.2.2.4.3.4.5#WP.4.2.2.4.3.4.5"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/WP.4.2.2.4.3.4/R/C.1.2.2.4.3.4.5#> as C.1.2.2.4.3.4.5_R {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://studioj.us/base#> as base
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base1
    uses <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis
    extends <http://studioj.us/mass-props-oml/WP.4.2.2.4.3.4/C/C.1.2.2.4.3.4.5#> as C.1.2.2.4.3.4.5
    uses <http://studioj.us/metrology#> as metrology
    extends <http://studioj.us/units#> as units

    instance C.1.2.2.4.3.4.5_mass_max : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.2.4.3.4.5_R.1"
        base1:hasDescription "The Part 36 mass shall not exceed 1.56 kg."
        analysis:requires C.1.2.2.4.3.4.5_mass_max_constraint
    ]

    instance C.1.2.2.4.3.4.5_mass_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.2.4.3.4.5:C.1.2.2.4.3.4.5_mass
        analysis:analyzes C.1.2.2.4.3.4.5_mass_max_value
    ]

    instance C.1.2.2.4.3.4.5_mass_max_value : metrology:MassValue [
        metrology:hasNumber 1.56e0
        metrology:hasUnit units:kg
    ]

    instance C.1.2.2.4.3.4.5_Cx_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.2.4.3.4.5_R.Cx_R.2"
        base1:hasDescription "The Part 36 Cx shall lie in the interval [-68.97, 46.36] mm."
        analysis:requires C.1.2.2.4.3.4.5_Cx_min_constraint, C.1.2.2.4.3.4.5_Cx_max_constraint
    ]

    instance C.1.2.2.4.3.4.5_Cx_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.2.4.3.4.5:C.1.2.2.4.3.4.5_Cx
        analysis:analyzes C.1.2.2.4.3.4.5_Cx_min_value
    ]

    instance C.1.2.2.4.3.4.5_Cx_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.2.4.3.4.5:C.1.2.2.4.3.4.5_Cx
        analysis:analyzes C.1.2.2.4.3.4.5_Cx_max_value
    ]

    instance C.1.2.2.4.3.4.5_Cx_min_value : metrology:LengthValue [
        metrology:hasNumber -68.97e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.4.3.4.5_Cx_max_value : metrology:LengthValue [
        metrology:hasNumber 46.36e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.4.3.4.5_Cy_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.2.4.3.4.5_R.Cy_R.3"
        base1:hasDescription "The Part 36 Cy shall lie in the interval [-9.71, 106.94] mm."
        analysis:requires C.1.2.2.4.3.4.5_Cy_min_constraint, C.1.2.2.4.3.4.5_Cy_max_constraint
    ]

    instance C.1.2.2.4.3.4.5_Cy_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.2.4.3.4.5:C.1.2.2.4.3.4.5_Cy
        analysis:analyzes C.1.2.2.4.3.4.5_Cy_min_value
    ]

    instance C.1.2.2.4.3.4.5_Cy_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.2.4.3.4.5:C.1.2.2.4.3.4.5_Cy
        analysis:analyzes C.1.2.2.4.3.4.5_Cy_max_value
    ]

    instance C.1.2.2.4.3.4.5_Cy_min_value : metrology:LengthValue [
        metrology:hasNumber -9.71e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.4.3.4.5_Cy_max_value : metrology:LengthValue [
        metrology:hasNumber 106.94e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.4.3.4.5_Cz_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.2.4.3.4.5_R.Cz_R.4"
        base1:hasDescription "The Part 36 Cz shall lie in the interval [-36.69, 81.69] mm."
        analysis:requires C.1.2.2.4.3.4.5_Cz_min_constraint, C.1.2.2.4.3.4.5_Cz_max_constraint
    ]

    instance C.1.2.2.4.3.4.5_Cz_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.2.4.3.4.5:C.1.2.2.4.3.4.5_Cz
        analysis:analyzes C.1.2.2.4.3.4.5_Cz_min_value
    ]

    instance C.1.2.2.4.3.4.5_Cz_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.2.4.3.4.5:C.1.2.2.4.3.4.5_Cz
        analysis:analyzes C.1.2.2.4.3.4.5_Cz_max_value
    ]

    instance C.1.2.2.4.3.4.5_Cz_min_value : metrology:LengthValue [
        metrology:hasNumber -36.69e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.2.4.3.4.5_Cz_max_value : metrology:LengthValue [
        metrology:hasNumber 81.69e0
        metrology:hasUnit units:mm
    ]
}
