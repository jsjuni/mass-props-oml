@dc:creator "http://studioj.us/mass-props-oml/WP.4.2.3.4.2/WP/WP.4.2.3.4.2.4#WP.4.2.3.4.2.4"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/WP.4.2.3.4.2.4/WP/WP.4.2.3.4.2.4.2#WP.4.2.3.4.2.4.2"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/WP.4.2.3.4.2.4/R/C.1.2.3.4.2.4.2#> as C.1.2.3.4.2.4.2_R {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://studioj.us/base#> as base
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base1
    uses <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis
    extends <http://studioj.us/mass-props-oml/WP.4.2.3.4.2.4/Q/C.1.2.3.4.2.4.2#> as C.1.2.3.4.2.4.2_Q
    uses <http://studioj.us/metrology#> as metrology
    extends <http://studioj.us/units#> as units

    instance C.1.2.3.4.2.4.2_mass_max : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.2.4.2_R.1"
        base1:hasDescription "The Part 58 mass shall not exceed 0.92 kg."
        analysis:requires C.1.2.3.4.2.4.2_mass_max_constraint
    ]

    instance C.1.2.3.4.2.4.2_mass_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.2.4.2_Q:C.1.2.3.4.2.4.2_mass
        analysis:analyzes C.1.2.3.4.2.4.2_mass_max_value
    ]

    instance C.1.2.3.4.2.4.2_mass_max_value : metrology:MassValue [
        metrology:hasNumber 0.92e0
        metrology:hasUnit units:kg
    ]

    instance C.1.2.3.4.2.4.2_Cx_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.2.4.2_R.Cx_R.2"
        base1:hasDescription "The Part 58 Cx shall lie in the interval [-164.32, -48.99] mm."
        analysis:requires C.1.2.3.4.2.4.2_Cx_min_constraint, C.1.2.3.4.2.4.2_Cx_max_constraint
    ]

    instance C.1.2.3.4.2.4.2_Cx_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4.2.4.2_Q:C.1.2.3.4.2.4.2_Cx
        analysis:analyzes C.1.2.3.4.2.4.2_Cx_min_value
    ]

    instance C.1.2.3.4.2.4.2_Cx_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.2.4.2_Q:C.1.2.3.4.2.4.2_Cx
        analysis:analyzes C.1.2.3.4.2.4.2_Cx_max_value
    ]

    instance C.1.2.3.4.2.4.2_Cx_min_value : metrology:LengthValue [
        metrology:hasNumber -164.32e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.4.2_Cx_max_value : metrology:LengthValue [
        metrology:hasNumber -48.99e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.4.2_Cy_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.2.4.2_R.Cy_R.3"
        base1:hasDescription "The Part 58 Cy shall lie in the interval [-48.69, 67.97] mm."
        analysis:requires C.1.2.3.4.2.4.2_Cy_min_constraint, C.1.2.3.4.2.4.2_Cy_max_constraint
    ]

    instance C.1.2.3.4.2.4.2_Cy_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4.2.4.2_Q:C.1.2.3.4.2.4.2_Cy
        analysis:analyzes C.1.2.3.4.2.4.2_Cy_min_value
    ]

    instance C.1.2.3.4.2.4.2_Cy_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.2.4.2_Q:C.1.2.3.4.2.4.2_Cy
        analysis:analyzes C.1.2.3.4.2.4.2_Cy_max_value
    ]

    instance C.1.2.3.4.2.4.2_Cy_min_value : metrology:LengthValue [
        metrology:hasNumber -48.69e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.4.2_Cy_max_value : metrology:LengthValue [
        metrology:hasNumber 67.97e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.4.2_Cz_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4.2.4.2_R.Cz_R.4"
        base1:hasDescription "The Part 58 Cz shall lie in the interval [-84.94, 33.44] mm."
        analysis:requires C.1.2.3.4.2.4.2_Cz_min_constraint, C.1.2.3.4.2.4.2_Cz_max_constraint
    ]

    instance C.1.2.3.4.2.4.2_Cz_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4.2.4.2_Q:C.1.2.3.4.2.4.2_Cz
        analysis:analyzes C.1.2.3.4.2.4.2_Cz_min_value
    ]

    instance C.1.2.3.4.2.4.2_Cz_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4.2.4.2_Q:C.1.2.3.4.2.4.2_Cz
        analysis:analyzes C.1.2.3.4.2.4.2_Cz_max_value
    ]

    instance C.1.2.3.4.2.4.2_Cz_min_value : metrology:LengthValue [
        metrology:hasNumber -84.94e0
        metrology:hasUnit units:mm
    ]

    instance C.1.2.3.4.2.4.2_Cz_max_value : metrology:LengthValue [
        metrology:hasNumber 33.44e0
        metrology:hasUnit units:mm
    ]
}
