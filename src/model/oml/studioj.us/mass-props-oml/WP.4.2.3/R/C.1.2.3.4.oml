@dc:creator "http://studioj.us/mass-props-oml/WP.4.2/WP/WP.4.2.3#WP.4.2.3"^^xsd:anyURI
@dc:rights "http://studioj.us/mass-props-oml/WP.4.2.3/WP/WP.4.2.3.4#WP.4.2.3.4"^^xsd:anyURI
description <http://studioj.us/mass-props-oml/WP.4.2.3/R/C.1.2.3.4#> as C.1.2.3.4_R {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2001/XMLSchema#> as xsd
    uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    uses <http://studioj.us/base#> as base
    uses <http://imce.jpl.nasa.gov/foundation/base#> as base1
    uses <http://imce.jpl.nasa.gov/foundation/analysis#> as analysis
    extends <http://studioj.us/mass-props-oml/WP.4.2.3/Q/C.1.2.3.4#> as C.1.2.3.4_Q
    uses <http://studioj.us/mass-properties-v#> as mass-properties-v
    uses <http://bipm.org/jcgm/vim3-v#> as vim3-v
    extends <http://iso.org/iso-80000/4.1-d#> as iso-80000-4.1-d
    extends <http://iso.org/iso-80000/3.1-d#> as iso-80000-3.1-d

    instance C.1.2.3.4_mass_max : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4_R.1"
        base1:hasDescription "The Subsystem 9 mass shall not exceed 10.73 kg."
        analysis:requires C.1.2.3.4_mass_max_constraint
    ]

    instance C.1.2.3.4_mass_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4_Q:C.1.2.3.4_mass
        analysis:analyzes C.1.2.3.4_mass_max_value
    ]

    instance C.1.2.3.4_mass_max_value : mass-properties-v:MassValue [
        vim3-v:hasNumber 10.73e0
        vim3-v:hasReference iso-80000-4.1-d:kilogram
    ]

    instance C.1.2.3.4_Cx_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4_R.Cx_R.2"
        base1:hasDescription "The Subsystem 9 Cx shall lie in the interval [-0.03, 0.02] mm."
        analysis:requires C.1.2.3.4_Cx_min_constraint, C.1.2.3.4_Cx_max_constraint
    ]

    instance C.1.2.3.4_Cx_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4_Q:C.1.2.3.4_Cx
        analysis:analyzes C.1.2.3.4_Cx_min_value
    ]

    instance C.1.2.3.4_Cx_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4_Q:C.1.2.3.4_Cx
        analysis:analyzes C.1.2.3.4_Cx_max_value
    ]

    instance C.1.2.3.4_Cx_min_value : mass-properties-v:CenterOfMassCoordinate [
        vim3-v:hasNumber -0.03e0
        vim3-v:hasReference iso-80000-3.1-d:millimetre
    ]

    instance C.1.2.3.4_Cx_max_value : mass-properties-v:CenterOfMassCoordinate [
        vim3-v:hasNumber 0.02e0
        vim3-v:hasReference iso-80000-3.1-d:millimetre
    ]

    instance C.1.2.3.4_Cy_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4_R.Cy_R.3"
        base1:hasDescription "The Subsystem 9 Cy shall lie in the interval [-0.04, 0.02] mm."
        analysis:requires C.1.2.3.4_Cy_min_constraint, C.1.2.3.4_Cy_max_constraint
    ]

    instance C.1.2.3.4_Cy_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4_Q:C.1.2.3.4_Cy
        analysis:analyzes C.1.2.3.4_Cy_min_value
    ]

    instance C.1.2.3.4_Cy_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4_Q:C.1.2.3.4_Cy
        analysis:analyzes C.1.2.3.4_Cy_max_value
    ]

    instance C.1.2.3.4_Cy_min_value : mass-properties-v:CenterOfMassCoordinate [
        vim3-v:hasNumber -0.04e0
        vim3-v:hasReference iso-80000-3.1-d:millimetre
    ]

    instance C.1.2.3.4_Cy_max_value : mass-properties-v:CenterOfMassCoordinate [
        vim3-v:hasNumber 0.02e0
        vim3-v:hasReference iso-80000-3.1-d:millimetre
    ]

    instance C.1.2.3.4_Cz_range : mission:Requirement [
        base:hasRequirementIdentifier "C.1.2.3.4_R.Cz_R.4"
        base1:hasDescription "The Subsystem 9 Cz shall lie in the interval [-0.02, 0.03] mm."
        analysis:requires C.1.2.3.4_Cz_min_constraint, C.1.2.3.4_Cz_max_constraint
    ]

    instance C.1.2.3.4_Cz_min_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "ge"
        analysis:explains C.1.2.3.4_Q:C.1.2.3.4_Cz
        analysis:analyzes C.1.2.3.4_Cz_min_value
    ]

    instance C.1.2.3.4_Cz_max_constraint : analysis:QuantityValueConstraint [
        analysis:hasQuantityValueRelation "le"
        analysis:explains C.1.2.3.4_Q:C.1.2.3.4_Cz
        analysis:analyzes C.1.2.3.4_Cz_max_value
    ]

    instance C.1.2.3.4_Cz_min_value : mass-properties-v:CenterOfMassCoordinate [
        vim3-v:hasNumber -0.02e0
        vim3-v:hasReference iso-80000-3.1-d:millimetre
    ]

    instance C.1.2.3.4_Cz_max_value : mass-properties-v:CenterOfMassCoordinate [
        vim3-v:hasNumber 0.03e0
        vim3-v:hasReference iso-80000-3.1-d:millimetre
    ]
}
